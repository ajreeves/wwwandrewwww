  },
  "methods": {
    "value": [
      "Quantitative analysis of state-level federal grant allocations from 1984 to 2008.",
      "Least squares regression models with state and year fixed effects, standard errors clustered on state.",
      "Control variables for majority party status, committee membership, electoral vulnerability, and House delegation partisanship.",
      "Placebo test using retirement and disability spending."
    ],
