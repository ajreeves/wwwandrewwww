  "abstract": {
    "value": "Analyzing the allocation of more than $8.5 trillion of federal grants across the states from 1984 to 2008, we show that presidential copartisan senators are more successful than opposition party members in securing federal dollars for their home states. Moreover, presidents appear to target grants ex post to states that gain presidential copartisans in recent elections.",
    "evidence_pages": [
      1
    ],
    "confidence": "high"
  },
  "one_sentence_summary": {
    "value": "Presidential copartisan senators secure more federal grant dollars for their states than opposition party senators, and presidents target grants to states that gain copartisan senators.",
    "evidence_pages": [
      1,
      2,
      20
    ],
    "confidence": "high"
  },
  "plain_english_summary": {
    "value": "Senators from the president’s party are better at bringing federal grant money to their states than senators from the other party, and presidents tend to direct more grants to states that recently elected senators from their own party.",
    "evidence_pages": [
      1,
      2,
      20
    ],
    "confidence": "high"
  },
  "research_question": {
    "value": "Do presidential politics shape distributive outcomes in the Senate, specifically in the allocation of federal grants across states?",
    "evidence_pages": [
      1,
      2
    ],
    "confidence": "high"
  },
  "main_findings": {
    "value": [
      "Presidential copartisan senators are more successful than opposition party senators in securing federal grant dollars for their states.",
      "Presidents target grants ex post to states that gain presidential copartisans in recent elections.",
      "The number of presidential copartisan senators is a strong predictor of per capita grant spending a state receives.",
      "No similar effect is found for federal retirement and disability spending, which is not subject to political influence."
    ],
