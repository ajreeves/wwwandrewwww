---
import "../styles/global.css";
import "../styles/editorial.css";
import { siteEnvironment } from "@data/site-environment";

interface Props {
  title?: string;
  description?: string;
  active?: string;
  image?: string;
  imageAlt?: string;
  ogType?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = "Andrew Reeves",
  description = "Research on power, place and accountability in American political life.",
  active = "",
  image = "/images/andrew-reeves-portrait-editorial.jpg",
  imageAlt = "Portrait of Andrew Reeves",
  ogType = "website",
  structuredData
} = Astro.props;

const pageTitle = title === "Andrew Reeves" ? title : `${title} - Andrew Reeves`;
const site = Astro.site ?? new URL("https://andrewreeves.org");
const canonicalUrl = new URL(Astro.url.pathname, site).toString();
const imageUrl = new URL(image, site).toString();
const jsonLdItems = Array.isArray(structuredData) ? structuredData : structuredData ? [structuredData] : [];
const navItems = [
  { label: "About", href: "/about/", activeOn: ["About"] },
  { label: "Research", href: "/research/", activeOn: ["Research"] },
  { label: "Books", href: "/books/", activeOn: ["Books"] },
  { label: "Teaching", href: "/teaching/", activeOn: ["Teaching", "Students"] },
  { label: "Media", href: "/news/", activeOn: ["News", "Talks"] },
  { label: "CV", href: "/cv/", activeOn: ["CV"] },
  { label: "Search", href: "/search/", activeOn: ["Search"] }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {siteEnvironment.noIndex && <meta name="robots" content="noindex, nofollow" />}
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.png" />
    {active === "CV" && (
      <>
        <link rel="preconnect" href="https://use.typekit.net" />
        <link rel="preload" href="https://use.typekit.net/dlf3syd.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
        <noscript><link rel="stylesheet" href="https://use.typekit.net/dlf3syd.css" /></noscript>
      </>
    )}
    <slot name="head" />
    {jsonLdItems.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body class:list={[active !== "CV" && "editorial-site"]}>
    <div class="site-shell">
      <a class="skip-link" href="#main">Skip to content</a>
      <header class="site-header">
        <nav class="site-nav" aria-label="Main navigation">
          {active === "CV" ? (
            <a class="nav-home" href="/" aria-label="Andrew Reeves home">
              <span class="site-title">Andrew Reeves</span>
            </a>
          ) : (
            <div class="site-brand">
              <a class="nav-home" href="/" aria-label="Andrew Reeves home">
                <span class="site-title">Andrew Reeves</span>
              </a>
              <a class="university-signature" href="https://washu.edu/">
                <img src="/brand/washu-logo.svg" alt="Washington University in St. Louis" width="132" height="32" />
              </a>
            </div>
          )}
          <button class="nav-toggle" aria-expanded="false" aria-controls="main-nav-list" aria-label="Open navigation menu">
            <span class="nav-toggle-bar"></span>
            <span class="nav-toggle-bar"></span>
            <span class="nav-toggle-bar"></span>
          </button>
          <div class="nav-list" id="main-nav-list">
            {
              navItems.map((item) => (
                <a class="nav-link" href={item.href} aria-current={item.activeOn.includes(active) ? "page" : undefined}>
                  {item.label}
                </a>
              ))
            }
          </div>
        </nav>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="site-footer-wrap">
        <div class="site-footer">
          <div class="footer-nav">
            <a href="/about/">About</a>
            <a href="/research/">Research</a>
            <a href="/books/">Books</a>
            <a href="/teaching/">Teaching</a>
            <a href="/students/">Students</a>
            <a href="/talks/">Talks</a>
            <a href="/news/">{active === "CV" ? "News" : "Media"}</a>
            <a href="/cv/">CV</a>
            <a href="/contact/">Contact</a>
            <a href="/search/">Search</a>
          </div>
          <div class="footer-links">
            <a href="mailto:reeves@wustl.edu">Email</a>
            <a href="https://scholar.google.com/citations?hl=en&user=xPSRkX4AAAAJ">Google Scholar</a>
            <a href="https://polisci.wustl.edu/people/andrew-reeves/">{active === "CV" ? "Department Profile" : "Department profile"}</a>
          </div>
        </div>
      </footer>
    </div>
    <script>
      // Fonts and responsive layouts can move a section after the browser's first
      // fragment jump. Correct it once, unless the reader has already interacted.
      const initialHash = window.location.hash;
      const initialSection = (() => {
        try {
          return document.getElementById(decodeURIComponent(initialHash.slice(1)));
        } catch {
          return null;
        }
      })();
      const navigation = performance.getEntriesByType("navigation")[0] as PerformanceNavigationTiming | undefined;
      // Leave reload and history restoration to the browser.
      if ((!navigation || navigation.type === "navigate") && initialSection?.closest("main")) {
        const interaction = new AbortController();
        let readerMoved = false;
        for (const event of ["wheel", "touchstart", "pointerdown", "keydown"]) {
          window.addEventListener(event, () => { readerMoved = true; }, { passive: true, signal: interaction.signal });
        }
        const alignInitialSection = async () => {
          await document.fonts.ready;
          requestAnimationFrame(() => requestAnimationFrame(() => {
            interaction.abort();
            if (!readerMoved && window.location.hash === initialHash) {
              initialSection.scrollIntoView({ block: "start", behavior: "instant" });
            }
          }));
        };
        if (document.readyState === "complete") alignInitialSection();
        else window.addEventListener("load", alignInitialSection, { once: true });
      }

      const navToggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
      const navList = document.getElementById("main-nav-list");

      const closeNavigation = () => {
        navToggle?.setAttribute("aria-expanded", "false");
        navToggle?.setAttribute("aria-label", "Open navigation menu");
        navList?.classList.remove("nav-list-open");
      };

      navToggle?.addEventListener("click", () => {
        const expanded = navToggle.getAttribute("aria-expanded") === "true";
        navToggle.setAttribute("aria-expanded", String(!expanded));
        navToggle.setAttribute("aria-label", expanded ? "Open navigation menu" : "Close navigation menu");
        navList?.classList.toggle("nav-list-open");
      });

      document.addEventListener("click", (e) => {
        const target = e.target as Node;
        if (!navToggle?.contains(target) && !navList?.contains(target)) {
          closeNavigation();
        }
      });

      // Keep the expanded header from covering the next keyboard destination.
      document.querySelector(".site-nav")?.addEventListener("focusout", (event) => {
        const next = (event as FocusEvent).relatedTarget;
        if (next instanceof Node && !navToggle?.contains(next) && !navList?.contains(next)) {
          closeNavigation();
        }
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && navToggle?.getAttribute("aria-expanded") === "true") {
          closeNavigation();
          navToggle.focus();
        }
      });
    </script>
    {siteEnvironment.analyticsEnabled && (
      <script is:inline defer data-domain="andrewreeves.org" src="https://plausible.io/js/script.js"></script>
    )}
  </body>
</html>
