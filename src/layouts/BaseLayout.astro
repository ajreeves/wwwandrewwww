---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  active?: string;
  image?: string;
  imageAlt?: string;
  ogType?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = "Andrew Reeves",
  description = "Research on power, place, and accountability in American political life.",
  active = "",
  image = "/images/andrew-reeves-portrait-editorial.jpg",
  imageAlt = "Portrait of Andrew Reeves",
  ogType = "website",
  structuredData
} = Astro.props;

const pageTitle = title === "Andrew Reeves" ? title : `${title} - Andrew Reeves`;
const site = Astro.site ?? new URL("https://andrewreeves.org");
const canonicalUrl = new URL(Astro.url.pathname, site).toString();
const imageUrl = new URL(image, site).toString();
const jsonLdItems = Array.isArray(structuredData) ? structuredData : structuredData ? [structuredData] : [];
const navItems = [
  ["Home", "/"],
  ["Research", "/research/"],
  ["Books", "/books/"],
  ["Students", "/students/"],
  ["Teaching", "/teaching/"],
  ["Talks", "/talks/"],
  ["News", "/news/"],
  ["CV", "/cv/"],
  ["Contact", "/contact/"]
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+SC:wght@500;600&display=swap" rel="stylesheet" />
    <link rel="preconnect" href="https://use.typekit.net" />
    <link rel="stylesheet" href="https://use.typekit.net/dlf3syd.css" />
    {jsonLdItems.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <div class="site-shell">
      <a class="skip-link" href="#main">Skip to content</a>
      <header class="site-header">
        <nav class="site-nav" aria-label="Main navigation">
          <a class="nav-home" href="/" aria-label="Andrew Reeves home">
            <span class="site-title">Andrew Reeves</span>
          </a>
          <div class="nav-list">
            {
              navItems.map(([label, href]) => (
                <a class="nav-link" href={href} aria-current={active === label ? "page" : undefined}>
                  {label}
                </a>
              ))
            }
          </div>
        </nav>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="site-footer-wrap">
        <div class="site-footer">
          <div class="footer-links">
            <a href="mailto:reeves@wustl.edu">Email</a>
            <a href="https://scholar.google.com/citations?hl=en&user=xPSRkX4AAAAJ">Google Scholar</a>
            <a href="https://polisci.wustl.edu/people/andrew-reeves/">Department Profile</a>
            <a href="/cv/">CV</a>
          </div>
        </div>
      </footer>
    </div>
    <!-- Default Statcounter code for Andrew Reeves (New)
    http://andrewreeves.org -->
    <script is:inline type="text/javascript">
      // @ts-nocheck
      var sc_project = 12348960;
      var sc_invisible = 1;
      var sc_security = "3aa7f28c";
    </script>
    <script
      is:inline
      type="text/javascript"
      src="https://www.statcounter.com/counter/counter.js"
      async
    ></script>
    <noscript>
      <div class="statcounter">
        <a title="Web Analytics Made Easy - Statcounter" href="https://statcounter.com/" target="_blank">
          <img
            class="statcounter"
            src="https://c.statcounter.com/12348960/0/3aa7f28c/1/"
            alt="Web Analytics Made Easy - Statcounter"
            referrerpolicy="no-referrer-when-downgrade"
          />
        </a>
      </div>
    </noscript>
    <!-- End of Statcounter Code -->
  </body>
</html>
