---
import ResponsiveImage from "@components/ResponsiveImage.astro";

interface Props {
  eyebrow?: string;
  title: string;
  text: string;
  image: string;
  alt: string;
  caption?: string;
  actionHref?: string;
  actionLabel?: string;
  reversed?: boolean;
  id?: string;
}

const { eyebrow, title, text, image, alt, caption, actionHref, actionLabel, reversed = false, id } = Astro.props;
---

<section id={id} class="container-wide page-section page-section-feature">
  <div class={`feature-band ${reversed ? "feature-band-reversed" : ""}`}>
    <figure class="feature-band-media">
      <ResponsiveImage
        src={image}
        alt={alt}
        loading="lazy"
        sizes="(min-width: 1200px) 670px, (min-width: 760px) 55vw, calc(100vw - 40px)"
      />
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
    <div class="feature-band-copy">
      {eyebrow && <p class="kicker">{eyebrow}</p>}
      <h2>{title}</h2>
      <p>{text}</p>
      {actionHref && actionLabel && <a class="ghost-button feature-band-action" href={actionHref}>{actionLabel}</a>}
    </div>
  </div>
</section>
