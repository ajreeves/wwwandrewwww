---
interface Props {
  eyebrow?: string;
  title: string;
  intro: string;
  actionHref?: string;
  actionLabel?: string;
}

const { eyebrow, title, intro, actionHref, actionLabel } = Astro.props;
---

<header class="container-wide page-opening">
  <div class="page-opening-panel">
    {eyebrow && <p class="kicker">{eyebrow}</p>}
    <h1 class="page-title">{title}</h1>
    <p class="page-intro">{intro}</p>
    {actionHref && actionLabel && <a class="editorial-button page-opening-action" href={actionHref}>{actionLabel}</a>}
  </div>
</header>
