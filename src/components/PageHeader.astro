---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  actionHref?: string;
  actionLabel?: string;
  compact?: boolean;
  compactMobile?: boolean;
}

const { eyebrow, title, intro, actionHref, actionLabel, compact, compactMobile } = Astro.props;
---

<header class:list={["container-wide page-opening", { "page-opening-mobile-compact": compactMobile }]}>
  <div class="page-opening-panel">
    {eyebrow && <p class="kicker">{eyebrow}</p>}
    <h1 class={compact ? "page-title page-title-compact" : "page-title"}>{title}</h1>
    {intro && <p class="page-intro">{intro}</p>}
    {actionHref && actionLabel && <a class="editorial-button page-opening-action" href={actionHref}>{actionLabel}</a>}
  </div>
</header>
