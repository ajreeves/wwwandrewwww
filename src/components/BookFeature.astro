---
interface Book {
  data: {
    title: string;
    subtitle?: string;
    summary: string;
    publisher: string;
    year: number | string;
    cover: string;
    coverCredit?: string;
    coauthors: string[];
    url?: string;
    amazonUrl?: string;
  };
  id: string;
}

interface Props {
  book: Book;
  reversed?: boolean;
  headingLevel?: 2 | 3;
  headingId?: string;
}

const { book, reversed = false, headingLevel = 3, headingId } = Astro.props;
const Heading = headingLevel === 2 ? "h2" : "h3";
const authorLine = book.id === "particularistic-president"
  ? [...book.data.coauthors, "Andrew Reeves"].join(" and ")
  : ["Andrew Reeves", ...book.data.coauthors].join(" and ");
const coverDimensions = book.id === "particularistic-president"
  ? { width: 427, height: 648 }
  : { width: 415, height: 648 };
---

<article class={`flw-feature-card book-feature-card ${reversed ? "flw-feature-card-reversed" : ""}`}>
  <figure class="flw-feature-media book-cover-panel">
    <div class="book-cover-object">
      <img
        src={book.data.cover}
        alt={`Cover of ${book.data.title}`}
        width={coverDimensions.width}
        height={coverDimensions.height}
        loading="lazy"
      />
    </div>
  </figure>
  <div class="flw-feature-copy">
    <Heading class="book-title" id={headingId}>
      {book.data.title}
    </Heading>
    {book.data.subtitle && <p class="book-subtitle">{book.data.subtitle}</p>}
    <p class="book-authors">{authorLine}</p>
    <p class="book-publisher">{book.data.publisher}, {book.data.year}</p>
    <p class="book-description">{book.data.summary}</p>
    <div class="book-action-row">
      {book.data.url && <a class="ghost-button" href={book.data.url}>Publisher</a>}
    </div>
  </div>
</article>
