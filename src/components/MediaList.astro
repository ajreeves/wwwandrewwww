---
interface Props {
  items: readonly { title: string; outlet: string; date: string; url: string }[];
  featured?: boolean;
}
const { items, featured = false } = Astro.props;
---

<ul class:list={["media-list", featured && "media-list-featured"]}>
  {items.map((item) => (
    <li>
      <p class="media-item-source">{item.outlet}{item.date ? ` · ${item.date}` : ""}</p>
      <h3><a href={item.url}>{item.title}</a></h3>
    </li>
  ))}
</ul>
