---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHeader from "@components/PageHeader.astro";
import FeatureBand from "@components/FeatureBand.astro";

// Dates describe the event, not the video upload. Retain month precision when
// the source does not establish a day. Speaker roles are historical context.
const events = [
  {
    title: "Ukraine at a Crossroads: Former Ukrainian President Viktor Yushchenko",
    date: "2026-10-28",
    dateLabel: "October 28, 2026",
    dateSource: "https://wc.washu.edu/past-events/ukraine-crossroads-former-ukrainian-president-viktor-yushchenko",
    watch: "https://www.youtube.com/watch?v=421Ykr1wdPY",
    embed: "https://www.youtube.com/embed/421Ykr1wdPY",
    label: "Ukraine at a Crossroads with Viktor Yushchenko",
    summary:
      "Former Ukrainian President Viktor Yushchenko discusses the war with Russia, Ukraine's future, and implications for Europe at the Weidenbaum Center's October 28, 2026 event, followed by a conversation with Vijay Ramani."
  },
  {
    title: "Governing Past Gridlock: Why Fiscal Responsibility Still Matters",
    date: "2026-01-14",
    dateLabel: "January 14, 2026",
    dateSource: "https://wc.washu.edu/past-events/governing-past-gridlock-why-fiscal-responsibility-still-matters",
    watch: "https://www.youtube.com/watch?v=-xeyS7nilpU",
    embed: "https://www.youtube.com/embed/-xeyS7nilpU",
    label: "Governing Past Gridlock",
    summary:
      "Former U.S. Representative Carolyn Bourdeaux discusses fiscal responsibility and political trust at a Weidenbaum Center event."
  },
  {
    title: "The Past, Present, and Future of the Federal Reserve",
    date: "2025-09-29",
    dateLabel: "September 29, 2025",
    dateSource: "https://happenings.washu.edu/event/the-past-present-and-future-of-the-federal-reserve",
    watch: "https://www.youtube.com/watch?v=TJEnJcU-PRE",
    embed: "https://www.youtube.com/embed/TJEnJcU-PRE",
    label: "Federal Reserve Conversation",
    summary:
      "A conversation on the Federal Reserve's evolving role in the U.S. economy with Alberto Musalem, James Bullard, and Thomas Melzer, moderated by Karen Branding."
  },
  {
    title: "The Future of Civic Education and Universities",
    date: "2025-09-04",
    dateLabel: "September 4, 2025",
    dateSource: "https://wc.washu.edu/ay-25-26-start-year-letter",
    watch: "https://www.youtube.com/watch?v=1T0Oz9wY6P4",
    embed: "https://www.youtube.com/embed/1T0Oz9wY6P4",
    label: "Future of Civic Education",
    summary:
      "Robert Doar, Benjamin Storey, and Andrew Reeves discuss how universities teach citizenship and encourage debate among people with different views."
  },
  {
    title: "Labor, Regulation, and the Changing Economy Panel",
    date: "2025-02-24",
    dateLabel: "February 24, 2025",
    dateSource: "https://wc.washu.edu/weidenbaum-center-newsletter-march-2025",
    watch: "https://www.youtube.com/watch?v=yUeC-xgeLVM",
    embed: "https://www.youtube.com/embed/yUeC-xgeLVM",
    label: "Labor and Regulation Panel",
    summary:
      "Pauline Kim moderates a panel on labor markets, regulation, tariffs, immigration, and upcoming policy changes."
  },
  {
    title: "A Fireside Chat with James Bullard",
    date: "2024-09",
    dateLabel: "September 2024",
    dateSource: "https://wc.washu.edu/weidenbaum-center-newsletter-august-2024",
    watch: "https://www.youtube.com/watch?v=jAvZp5nLsFs",
    embed: "https://www.youtube.com/embed/jAvZp5nLsFs",
    label: "Fireside Chat with James Bullard",
    summary:
      "A conversation with Andrew Reeves and James Bullard on the economy, elections, and higher education leadership."
  },
  {
    title: "April 2024 Forum: The Outlook for the U.S. Economy and Monetary Policy with Adriana D. Kugler",
    date: "2024-04-03",
    dateLabel: "April 3, 2024",
    dateSource: "https://www.federalreserve.gov/newsevents/speech/kugler20240403a.htm",
    watch: "https://www.youtube.com/watch?v=qpFScg4RRyY",
    embed: "https://www.youtube.com/embed/qpFScg4RRyY",
    label: "U.S. Economy and Monetary Policy Forum",
    summary:
      "A forum on the U.S. economic outlook and monetary policy with Adriana D. Kugler, then a Federal Reserve governor, followed by Q&A with Andrew Reeves."
  },
  {
    title: "December 2023 Policy Lunch: Andrew Reeves on Concerns over Presidential Executive Power",
    date: "2023-12",
    dateLabel: "December 2023",
    dateSource: "https://wc.washu.edu/weidenbaum-center-newsletter-december-2023",
    watch: "https://www.youtube.com/watch?v=9uWOQAFgWNc",
    embed: "https://www.youtube.com/embed/9uWOQAFgWNc",
    label: "Policy Lunch on Executive Power",
    summary:
      "Andrew Reeves discusses No Blank Check and why the public is often skeptical of presidents acting without Congress."
  },
  {
    title: "January 2023: Hoover Fellow and Presidential Campaign Advisor: A Conversation with Lanhee J. Chen",
    date: "2023-01",
    dateLabel: "January 2023",
    dateSource: "https://www.youtube.com/watch?v=FEn1wxqnSUQ",
    watch: "https://www.youtube.com/watch?v=FEn1wxqnSUQ",
    embed: "https://www.youtube.com/embed/FEn1wxqnSUQ",
    label: "Conversation with Lanhee J. Chen",
    summary:
      "A conversation with Lanhee J. Chen about partisanship, campaign strategy, and the 2024 election."
  }
] as const;

const youtubeId = (url: string) => new URL(url).searchParams.get("v") ?? "";
---

<BaseLayout title="Talks & Events" active="Talks" description="Public events, talks, and recorded conversations featuring Andrew Reeves and the Weidenbaum Center.">
  <PageHeader
    eyebrow="Public Events"
    title="Talks & Events"
    intro="Recordings of talks, panels, and conversations from the Weidenbaum Center and Andrew Reeves’s public work."
  />

  <FeatureBand
    eyebrow="Featured Event"
    title="The Past, Present, and Future of the Federal Reserve"
    text="Andrew Reeves introduced this Weidenbaum Center conversation with Alberto Musalem, James Bullard, and Thomas Melzer on September 29, 2025. Karen Branding moderated the discussion."
    image="/images/andrew-fed-page.jpg"
    alt="Andrew Reeves at a Weidenbaum Center Federal Reserve event with Karen Branding, Thomas Melzer, Alberto Musalem, and James Bullard"
    caption="Photo: Sid Hastings/WashU."
    actionHref="https://www.youtube.com/watch?v=TJEnJcU-PRE"
    actionLabel="Watch recording"
  />

  <section class="container-wide page-section">
    <div class="page-section-heading">
      <div>
        <p class="kicker mb-4">Recordings</p>
        <h2>Weidenbaum Center Events</h2>
        <p class="mt-4 max-w-3xl text-xl leading-[1.55] text-muted">
          Dates are the event dates, and speakers’ titles are those they held at the time.
        </p>
      </div>
      <a class="hidden section-action sm:inline" href="https://www.youtube.com/channel/UCvJOmn5O0jvtON27hM5GXew">YouTube channel</a>
    </div>

    <div class="grid gap-6 lg:grid-cols-2">
      {
        events.map((event) => (
          <article class="editorial-card">
            <div class="video-frame video-frame-placeholder">
              <button
                type="button"
                class="video-load-button"
                data-youtube-embed={event.embed}
                data-youtube-title={event.title}
                aria-label={`Load video: ${event.title}`}
              >
                <img
                  src={`https://i.ytimg.com/vi/${youtubeId(event.watch)}/hqdefault.jpg`}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
                <span>Play recording</span>
              </button>
            </div>
            <p class="small-caps mb-3 mt-5">Recorded event · <time datetime={event.date}>{event.dateLabel}</time></p>
            <h3 class="list-title">
              <a class="text-ink no-underline hover:text-olive-dark" href={event.watch}>{event.label}</a>
            </h3>
            <p class="mt-3 text-base leading-[1.6] text-muted">{event.summary}</p>
            <a class="event-source-link" href={event.dateSource}>Event source<span class="sr-only">: {event.label}</span></a>
          </article>
        ))
      }
    </div>
  </section>

  <script>
    document.querySelectorAll<HTMLButtonElement>("[data-youtube-embed]").forEach((button) => {
      button.addEventListener("click", () => {
        const embed = button.dataset.youtubeEmbed;
        if (!embed) return;

        const title = button.dataset.youtubeTitle || "YouTube video";
        const iframe = document.createElement("iframe");
        iframe.src = `${embed}${embed.includes("?") ? "&" : "?"}autoplay=1`;
        iframe.title = title;
        iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
        iframe.allowFullscreen = true;
        iframe.referrerPolicy = "strict-origin-when-cross-origin";
        iframe.tabIndex = 0;

        button.replaceWith(iframe);
        iframe.focus({ preventScroll: true });
      });
    });
  </script>
</BaseLayout>

<style>
  .event-source-link { display: inline-flex; align-items: center; min-height: 28px; margin-top: 0.75rem; font-size: 0.9rem; }
</style>
