---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHeader from "@components/PageHeader.astro";
import RecordingPreview from "@components/RecordingPreview.astro";
import { eventAnchor } from "../utils/content-anchors";

import { events, eventPhotos } from "@data/talks";
import { siteEnvironment } from "@data/site-environment";
import "../styles/talks.css";

const youtubeId = (url: string) => new URL(url).searchParams.get("v") ?? "";
const featuredIds = ["9uWOQAFgWNc", "qpFScg4RRyY", "1T0Oz9wY6P4", "jAvZp5nLsFs"];
const featuredEvents = featuredIds.map((id) => {
  const event = events.find((event) => youtubeId(event.watch) === id);
  if (!event) throw new Error(`Missing featured recording: ${id}`);
  return event;
});
const recordingRoles: Record<string, string> = {
  "9uWOQAFgWNc": "Speaker: Andrew Reeves",
  "qpFScg4RRyY": "Q&A with Andrew Reeves",
  "1T0Oz9wY6P4": "Panelist: Andrew Reeves",
  "jAvZp5nLsFs": "Conversation with Andrew Reeves"
};
const recordingSections = [
  { id: "featured-recordings", title: "With Andrew Reeves", events: featuredEvents },
  { id: "event-archive", title: "From the Weidenbaum Center archive", events: events.filter((event) => !featuredIds.includes(youtubeId(event.watch))) }
];
// New preview assets must resolve before the production site is released.
const shareImage = new URL("/images/editorial/talks-share.jpg",
  siteEnvironment.noIndex && process.env.DEPLOY_PRIME_URL
    ? process.env.DEPLOY_PRIME_URL : Astro.site ?? "https://andrewreeves.org").href;
---

<BaseLayout title="Talks and Conversations" active="Talks" description="Talks, panels, and recorded conversations with Andrew Reeves, followed by selected events from the Weidenbaum Center archive." image={shareImage} imageAlt="Talks and events — Andrew Reeves at Washington University in St. Louis; Adriana Kugler in conversation with Reeves.">
  <div class="talks-page">
  <PageHeader
    title="Talks and events"
    intro="Talks, panels, and conversations in which Andrew Reeves discusses research and public affairs."
    compactMobile
  />

  {recordingSections.map((section) => (
    <section class="container-wide page-section" aria-labelledby={section.id}>
      <div class="page-section-heading">
        <div>
          <h2 id={section.id}>{section.title}</h2>
          {section.id === "event-archive" && <p class="mt-3 max-w-3xl text-sm leading-[1.55] text-muted">
            Other selected center events, including conversations led by colleagues. Dates and speakers’ titles refer to the time of each event.
          </p>}
        </div>
        {section.id === "event-archive" && <a class="hidden section-action sm:inline" href="https://www.youtube.com/channel/UCvJOmn5O0jvtON27hM5GXew">YouTube channel</a>}
      </div>

      <div class:list={section.id === "event-archive" ? "recording-archive" : "grid gap-6 lg:grid-cols-2"}>
        {section.events.map((event) => (
          <article id={eventAnchor(event.watch)} class="editorial-card recording-card">
            {section.id === "featured-recordings" && <RecordingPreview title={event.title} embed={event.embed} watch={event.watch} photo={eventPhotos[youtubeId(event.watch)]}
              speakerPoster={youtubeId(event.watch) === "9uWOQAFgWNc" ? { name: "Andrew Reeves", topic: "No Blank Check", src: "/images/editorial/andrew-reeves-portrait.jpg" } : undefined} />}
            <p class="small-caps mb-3 mt-5">{recordingRoles[youtubeId(event.watch)] ?? "Recorded event"} · <time datetime={event.date}>{event.dateLabel}</time></p>
            <h3 class="list-title">
              <a class="text-ink no-underline hover:text-olive-dark" href={event.watch}>{event.label}</a>
            </h3>
            <p class="mt-3 text-base leading-[1.6] text-muted">{event.summary}</p>
            {section.id === "event-archive" && <a class="event-source-link" href={event.watch}>Watch recording<span class="sr-only">: {event.label}</span></a>}
            <a class="event-source-link" href={event.dateSource}>Event source<span class="sr-only">: {event.label}</span></a>
          </article>
        ))}
      </div>
    </section>
  ))}
  </div>

  <script>
    document.querySelectorAll<HTMLButtonElement>("[data-youtube-embed]").forEach((button) => {
      button.addEventListener("click", () => {
        const embed = button.dataset.youtubeEmbed;
        if (!embed) return;

        const title = button.dataset.youtubeTitle || "YouTube video";
        const iframe = document.createElement("iframe");
        iframe.src = `${embed}${embed.includes("?") ? "&" : "?"}autoplay=1`;
        iframe.title = title;
        iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
        iframe.allowFullscreen = true;
        iframe.referrerPolicy = "strict-origin-when-cross-origin";
        iframe.tabIndex = 0;

        button.replaceWith(iframe);
        iframe.focus({ preventScroll: true });
      });
    });
  </script>
</BaseLayout>
