---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHeader from "@components/PageHeader.astro";
import FeatureBand from "@components/FeatureBand.astro";
import { eventAnchor } from "../utils/content-anchors";

import { events } from "@data/talks";

const youtubeId = (url: string) => new URL(url).searchParams.get("v") ?? "";
---

<BaseLayout title="Talks and events" active="Talks" description="Public events, talks and recorded conversations featuring Andrew Reeves and the Weidenbaum Center.">
  <PageHeader
    title="Talks and events"
    intro="Recordings of talks, panels and conversations from the Weidenbaum Center and Andrew Reeves’s public work."
  />

  <FeatureBand
    title="The Past, Present, and Future of the Federal Reserve"
    text="Andrew Reeves introduced this Weidenbaum Center conversation with Alberto Musalem, James Bullard and Thomas Melzer on Sept. 29, 2025. Karen Branding moderated the discussion."
    image="/images/andrew-fed-page.jpg"
    alt="Andrew Reeves at a Weidenbaum Center Federal Reserve event with Karen Branding, Thomas Melzer, Alberto Musalem and James Bullard"
    caption="Photo: Sid Hastings/WashU."
    actionHref="https://www.youtube.com/watch?v=TJEnJcU-PRE"
    actionLabel="Watch recording"
  />

  <section class="container-wide page-section">
    <div class="page-section-heading">
      <div>
        <h2>Weidenbaum Center events</h2>
        <p class="mt-4 max-w-3xl text-xl leading-[1.55] text-muted">
          Dates are the event dates, and speakers’ titles are those they held at the time.
        </p>
      </div>
      <a class="hidden section-action sm:inline" href="https://www.youtube.com/channel/UCvJOmn5O0jvtON27hM5GXew">YouTube channel</a>
    </div>

    <div class="grid gap-6 lg:grid-cols-2">
      {
        events.map((event) => (
          <article id={eventAnchor(event.watch)} class="editorial-card">
            <div class="video-frame video-frame-placeholder">
              <button
                type="button"
                class="video-load-button"
                data-youtube-embed={event.embed}
                data-youtube-title={event.title}
                aria-label={`Load video: ${event.title}`}
              >
                <img
                  src={`https://i.ytimg.com/vi/${youtubeId(event.watch)}/hqdefault.jpg`}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
                <span>Play recording</span>
              </button>
            </div>
            <p class="small-caps mb-3 mt-5">Recorded event · <time datetime={event.date}>{event.dateLabel}</time></p>
            <h3 class="list-title">
              <a class="text-ink no-underline hover:text-olive-dark" href={event.watch}>{event.label}</a>
            </h3>
            <p class="mt-3 text-base leading-[1.6] text-muted">{event.summary}</p>
            <a class="event-source-link" href={event.dateSource}>Event source<span class="sr-only">: {event.label}</span></a>
          </article>
        ))
      }
    </div>
  </section>

  <script>
    document.querySelectorAll<HTMLButtonElement>("[data-youtube-embed]").forEach((button) => {
      button.addEventListener("click", () => {
        const embed = button.dataset.youtubeEmbed;
        if (!embed) return;

        const title = button.dataset.youtubeTitle || "YouTube video";
        const iframe = document.createElement("iframe");
        iframe.src = `${embed}${embed.includes("?") ? "&" : "?"}autoplay=1`;
        iframe.title = title;
        iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
        iframe.allowFullscreen = true;
        iframe.referrerPolicy = "strict-origin-when-cross-origin";
        iframe.tabIndex = 0;

        button.replaceWith(iframe);
        iframe.focus({ preventScroll: true });
      });
    });
  </script>
</BaseLayout>

<style>
  .event-source-link { display: inline-flex; align-items: center; min-height: 28px; margin-top: 0.75rem; font-size: 0.9rem; }
</style>
