---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHeader from "@components/PageHeader.astro";
import { publicationSearchEntry } from "../utils/publication-records";
import { yearRank } from "../utils/publications";
import { supplementalSearchEntries } from "../utils/site-search";

const collections = await Promise.all([
  getCollection("publications"),
  getCollection("books"),
  getCollection("writing")
]);

const [publications, books, writing] = collections;
const publicationIndex = [
  ...publications.filter((entry) => entry.data.type !== "Book").map(publicationSearchEntry),
  ...books.map((entry) => ({
    title: entry.data.title,
    summary: entry.data.summary,
    type: "Book",
    year: entry.data.year,
    searchText: [entry.data.title, entry.data.subtitle, entry.data.summary, "Andrew Reeves", ...entry.data.coauthors, entry.data.publisher, entry.data.year, ...entry.data.themes, entry.body].join(" ").toLowerCase(),
    url: `/books/#${entry.id}`
  })),
  ...writing.map((entry) => ({
    title: entry.data.title,
    summary: entry.data.summary,
    type: "Writing",
    year: entry.data.year,
    searchText: [entry.data.title, entry.data.summary, entry.data.dek, entry.data.outlet, "Andrew Reeves", entry.data.year, ...entry.data.themes, entry.body].join(" ").toLowerCase(),
    url: entry.data.url ?? "/news/"
  }))
].sort((a, b) => yearRank(b.year) - yearRank(a.year));
const searchIndex = [...supplementalSearchEntries, ...publicationIndex];
---

<BaseLayout title="Search" active="Search" noIndex description="Search Andrew Reeves’s research, students, courses, leadership, talks, and public writing.">
  <PageHeader
    title="Search"
    intro="Find research, students, courses, university leadership, talks, and public writing."
    compactMobile
  />
  <section class="container-narrow page-section" data-search-page>
    <label class="small-caps mb-3 block" for="site-search">Search terms</label>
    <input
      id="site-search"
      type="search"
      class="w-full border border-rule bg-ivory px-5 py-4 font-serif text-xl text-ink outline-none transition focus:border-olive-dark"
      placeholder="Name, title, course or topic…"
      autocomplete="off"
      data-search-input
    />
    <p class="mt-4 text-base text-muted" aria-live="polite" data-search-count>Enter a search term to see results.</p>
    <nav class="search-browse" aria-label="Browse the site" data-search-start>
      <p>Or browse:</p>
      <div>
        <a href="/research/">Research</a>
        <a href="/students/">Students</a>
        <a href="/teaching/">Teaching</a>
        <a href="/talks/">Talks and events</a>
      </div>
    </nav>
    <noscript><p>JavaScript is needed for search. Use the links above to browse the site.</p></noscript>
    <div class="mt-8 grid gap-4" data-search-results hidden></div>
  </section>
  <script is:inline type="application/json" id="search-data" set:html={JSON.stringify(searchIndex)} />
  <script is:inline>
    const dataEl = document.getElementById("search-data");
    const items = dataEl ? JSON.parse(dataEl.textContent || "[]") : [];
    const input = document.querySelector("[data-search-input]");
    const results = document.querySelector("[data-search-results]");
    const count = document.querySelector("[data-search-count]");
    const start = document.querySelector("[data-search-start]");

    function escapeHtml(value) {
      return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function score(item, query) {
      return query.every((term) => item.searchText.includes(term));
    }

    function queryTerms() {
      return String(input?.value || "")
        .trim()
        .toLowerCase()
        .split(/\s+/)
        .filter(Boolean);
    }

    function updateUrl() {
      if (!input) return;
      const params = new URLSearchParams(window.location.search);
      const q = input.value.trim();
      if (q) params.set("q", q);
      else params.delete("q");
      const query = params.toString();
      window.history.replaceState({}, "", `${window.location.pathname}${query ? `?${query}` : ""}${window.location.hash}`);
    }

    function render(shouldUpdateUrl = true) {
      if (!results) return;
      const terms = queryTerms();
      const isEmpty = terms.length === 0;
      results.hidden = isEmpty;
      if (start) start.hidden = !isEmpty;
      if (isEmpty) {
        results.innerHTML = "";
        if (count) count.textContent = "Enter a search term to see results.";
        if (shouldUpdateUrl) updateUrl();
        return;
      }
      const matches = items.filter((item) => score(item, terms));
      results.innerHTML = matches
        .map(
          (item) => `
            <article class="border-b border-rule py-5" data-search-result>
              <p class="small-caps mb-2">${escapeHtml(item.type)}${item.year ? ` · ${escapeHtml(item.year)}` : ""}</p>
              <h2 class="list-title"><a class="text-ink no-underline hover:text-olive-dark" href="${escapeHtml(item.url)}">${escapeHtml(item.title)}</a></h2>
              <p class="mt-3 text-lg leading-[1.55] text-muted">${escapeHtml(item.summary)}</p>
            </article>
          `
        )
        .join("") || '<p class="text-lg">No matches. Try a name or a shorter search, or browse <a href="/research/">Research</a>, <a href="/students/">Students</a> or <a href="/teaching/">Teaching</a>.</p>';
      if (count) count.textContent = `${matches.length} result${matches.length === 1 ? "" : "s"}.`;
      if (shouldUpdateUrl) updateUrl();
    }

    if (input) {
      const params = new URLSearchParams(window.location.search);
      input.value = params.get("q") || "";
    }

    input?.addEventListener("input", () => render());
    window.addEventListener("popstate", () => {
      if (!input) return;
      const params = new URLSearchParams(window.location.search);
      input.value = params.get("q") || "";
      render(false);
    });
    render(false);
  </script>
</BaseLayout>
