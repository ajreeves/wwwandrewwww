---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import PublicationBrowser from "@components/PublicationBrowser.astro";
import PageHeader from "@components/PageHeader.astro";
import { researchTopics, researchTopicPath } from "@data/research-topics";

const yearRank = (year: number | string) => (typeof year === "number" ? year : 9999);
const publications = (await getCollection("publications")).sort((a, b) => yearRank(b.data.year) - yearRank(a.data.year) || a.data.title.localeCompare(b.data.title));
---

<BaseLayout title="Research and Publications" active="Research" description="Research by Andrew Reeves on presidential power, democratic accountability, political geography and federal resource allocation.">
  <PageHeader
    title="Publications"
    intro="Publications by Andrew Reeves on the presidency, public opinion, political geography and federal spending."
  />

  <nav class="container-wide research-topic-navigation" aria-labelledby="browse-topics-heading">
    <h2 id="browse-topics-heading">Browse by topic</h2>
    <ul>
      {researchTopics.map((topic) => (
        <li><a href={researchTopicPath(topic.slug)}>{topic.label}</a></li>
      ))}
    </ul>
  </nav>

  <PublicationBrowser
    publications={publications}
    heading="Publication archive"
  />
</BaseLayout>

<style>
  .research-topic-navigation { margin-bottom: 28px; }
  .research-topic-navigation h2 { margin: 0 0 8px; font-family: var(--font-sans); font-size: 18px; font-weight: 600; line-height: 1.4; }
  .research-topic-navigation ul { display: flex; flex-wrap: wrap; gap: 4px 24px; margin: 0; padding: 0; list-style: none; }
  .research-topic-navigation a { display: inline-flex; align-items: center; min-height: 44px; font-size: 16px; line-height: 1.4; text-decoration: underline; text-decoration-color: var(--rule); text-underline-offset: 5px; }
  .research-topic-navigation a:hover { text-decoration-color: currentColor; }
  @media (max-width: 760px) {
    .research-topic-navigation ul { column-gap: 20px; }
  }
</style>
