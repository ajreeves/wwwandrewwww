---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import PublicationBrowser from "@components/PublicationBrowser.astro";
import PageHeader from "@components/PageHeader.astro";
import { researchTopics, researchTopicPath } from "@data/research-topics";

const yearRank = (year: number | string) => (typeof year === "number" ? year : 9999);
const publications = (await getCollection("publications")).sort((a, b) => yearRank(b.data.year) - yearRank(a.data.year) || a.data.title.localeCompare(b.data.title));
---

<BaseLayout title="Research and Publications" active="Research" description="Research by Andrew Reeves on presidential power, democratic accountability, political geography, and federal resource allocation.">
  <PageHeader
    title="Publications"
    intro="Publications by Andrew Reeves on the presidency, public opinion, political geography, and federal spending."
  />

  <nav class="container-wide research-topic-navigation" aria-labelledby="browse-topics-heading">
    <h2 id="browse-topics-heading">Browse by topic</h2>
    <button type="button" class="research-topic-toggle" aria-expanded="false" aria-controls="research-topic-links" hidden>Browse by topic <span aria-hidden="true">+</span></button>
    <ul id="research-topic-links">
      {researchTopics.map((topic) => (
        <li><a href={researchTopicPath(topic.slug)}>{topic.label}</a></li>
      ))}
    </ul>
  </nav>

  <PublicationBrowser
    publications={publications}
    heading="Publication archive"
  />
</BaseLayout>

<script>
  const navigation = document.querySelector<HTMLElement>(".research-topic-navigation");
  const heading = navigation?.querySelector<HTMLElement>("h2");
  const toggle = navigation?.querySelector<HTMLButtonElement>(".research-topic-toggle");
  const links = navigation?.querySelector<HTMLElement>("ul");
  if (heading && toggle && links) {
    const mobile = window.matchMedia("(max-width: 760px)");
    const setExpanded = (expanded: boolean) => {
      toggle.setAttribute("aria-expanded", String(expanded));
      toggle.querySelector("span")!.textContent = expanded ? "−" : "+";
      links.hidden = !expanded;
    };
    const syncLayout = () => {
      heading.hidden = mobile.matches;
      toggle.hidden = !mobile.matches;
      setExpanded(!mobile.matches);
    };
    toggle.addEventListener("click", () => setExpanded(toggle.getAttribute("aria-expanded") !== "true"));
    mobile.addEventListener("change", syncLayout);
    syncLayout();
  }
</script>

<style>
  .research-topic-navigation { margin-bottom: 28px; }
  .research-topic-navigation h2 { margin: 0 0 8px; font-family: var(--font-sans); font-size: 18px; font-weight: 600; line-height: 1.4; }
  .research-topic-navigation ul { display: flex; flex-wrap: wrap; gap: 4px 24px; margin: 0; padding: 0; list-style: none; }
  .research-topic-navigation a { display: inline-flex; align-items: center; min-height: 44px; font-size: 16px; line-height: 1.4; text-decoration: underline; text-decoration-color: var(--rule); text-underline-offset: 5px; }
  .research-topic-navigation a:hover { text-decoration-color: currentColor; }
  .research-topic-navigation [hidden] { display: none; }
  .research-topic-toggle { width: 100%; min-height: 44px; display: flex; align-items: center; justify-content: space-between; padding: 10px 0; border: 0; border-block: 1px solid var(--rule); background: transparent; color: var(--ink); font-family: var(--font-sans); font-size: 16px; text-align: left; cursor: pointer; }
  .research-topic-toggle:focus-visible { outline: 2px solid var(--ink); outline-offset: 4px; }
  @media (max-width: 760px) {
    .research-topic-navigation { margin-bottom: 20px; }
    .research-topic-toggle[aria-expanded="true"] { margin-bottom: 8px; }
    .research-topic-navigation ul { column-gap: 20px; }
  }
</style>
