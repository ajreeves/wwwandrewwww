---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import { researchTopicPath } from "@data/research-topics";
import { getPublicationMetadata, validatePublicationMappings, type Publication } from "../../utils/publication-records";
import publicationFigures from "../../data/publication-figures.json";
import { normalizeTitle, yearRank, publicationSummary } from "../../utils/publications";
import ResponsiveImage from "@components/ResponsiveImage.astro";
import { publicationLinks, publicationCitation } from "../../utils/publication-citations";

type PublicationFigure = {
  src: string;
  alt: string;
  caption: string;
  kind?: string;
  fallback?: boolean;
};

export async function getStaticPaths() {
  const publications = await getCollection("publications");
  validatePublicationMappings(publications);
  return publications.map((publication) => ({
    params: { slug: publication.id },
    props: { publication }
  }));
}

interface Props { publication: Publication; }
const { publication } = Astro.props;
const allPublications = await getCollection("publications");
const figureManifest = publicationFigures as Record<string, PublicationFigure>;

const cleanText = (value?: string | number | null) =>
  String(value ?? "")
    .replace(/\s+/g, " ")
    .trim();

const metadata = getPublicationMetadata(publication);
const rawFigure = figureManifest[publication.id];
const publicationFigure = rawFigure && !rawFigure.fallback ? rawFigure : undefined;
const heroFigure = publicationFigure?.kind !== "poster" ? publicationFigure : undefined;
const supplementalPoster = publicationFigure?.kind === "poster" ? publicationFigure : undefined;

const asList = (value?: string[] | null) => (Array.isArray(value) ? value.map(cleanText).filter(Boolean) : []);

const meaningfulValue = (value?: string | number | null) => {
  const text = cleanText(value);
  if (!text || text === "0" || text === "00") return "";
  return text;
};

const formatAuthors = (authors: string[]) => {
  if (authors.length <= 2) return authors.join(" and ");
  return `${authors.slice(0, -1).join(", ")}, and ${authors.at(-1)}`;
};

const venue = cleanText(metadata?.journal) || publication.data.venue;
const contribution = publicationSummary(publication.data, metadata);
const abstract = cleanText(metadata?.abstract);
const fullCitation = cleanText(metadata?.citation ?? publication.data.citation);
const authors = publication.data.authors.length ? publication.data.authors : metadata?.authors ?? [];

const primaryLinks = publicationLinks(publication, metadata);
const { tags: citationTags, bibtex } = publicationCitation(publication, metadata);

const themeTerms = new Map([
  ["presidential power", "presidential-power"],
  ["executive power", "presidential-power"],
  ["unilateral action", "presidential-power"],
  ["presidential accountability", "democratic-accountability"],
  ["democratic accountability", "democratic-accountability"],
  ["public opinion", "democratic-accountability"],
  ["political geography", "political-geography"],
  ["geographic context", "political-geography"],
  ["urban-rural politics", "political-geography"],
  ["electoral geography", "political-geography"],
  ["federal resource allocation", "federal-resource-allocation"],
  ["distributive politics", "federal-resource-allocation"],
  ["disaster politics", "federal-resource-allocation"],
  ["federal spending", "federal-resource-allocation"]
]);

const themeHref = (theme: string) => {
  const themeKey = normalizeTitle(theme);
  const majorTheme = themeTerms.get(themeKey);
  return majorTheme ? researchTopicPath(majorTheme) : `/research/?q=${encodeURIComponent(theme)}`;
};

const editorial = publication.data.editorial;
const isReview = publication.data.type === "Review";
const publicationThemeLinks = Array.from(new Set(publication.data.themes)).slice(0, 5);
const methodLikeTags = new Set([
  "observational study",
  "survey analysis",
  "regression models",
  "robustness checks",
  "falsification tests",
  "quasi experimental",
  "quasi experimental precinct level voting analysis"
]);
const normalizeTag = (value: string) => normalizeTitle(value).replace(/\s+/g, " ");
const keywordThemes = Array.from(new Set([
  ...(editorial?.keywords ?? []),
  ...asList(metadata?.tags)
]))
  .filter((theme) => {
    const key = normalizeTag(theme);
    return (
      !publicationThemeLinks.some((existing) => normalizeTag(existing) === key) &&
      !methodLikeTags.has(key)
    );
  })
  .slice(0, 6);
const visibleThemes = Array.from(new Set([...publicationThemeLinks, ...keywordThemes])).slice(0, 10);

const contextParagraphs = editorial?.context ?? (metadata?.policy_relevance ? [cleanText(metadata.policy_relevance)] : []);
const keyFindings = (editorial?.findings ?? asList(metadata?.research_highlights)).slice(0, 5);
const designRows = (isReview ? [
  { label: "Format", value: editorial?.designLabel || "Critical book review" },
  { label: "Evidence discussed in the book", value: asList(metadata?.data_sources).join("; ") }
] : [
  { label: "Design", value: editorial?.designLabel || meaningfulValue(metadata?.identification_strategy) || asList(metadata?.filters.research_design).join("; ") || (publication.data.type === "Book" ? "Book-length scholarly monograph" : "") },
  { label: "Data", value: asList(metadata?.data_sources).join("; ") },
  { label: "Geography", value: meaningfulValue(metadata?.geography) },
  { label: "Time Period", value: meaningfulValue(metadata?.time_period) },
  { label: "Unit of Analysis", value: meaningfulValue(metadata?.unit_of_analysis) },
  { label: "Methods", value: asList(metadata?.methods).join("; ") }
]).filter((row) => row.value);

const citationRows = [
  { label: "Venue", value: venue },
  { label: "Volume", value: meaningfulValue(metadata?.volume) },
  { label: "Issue", value: meaningfulValue(metadata?.issue) },
  { label: "Pages", value: meaningfulValue(metadata?.pages) },
  { label: "DOI", value: meaningfulValue(metadata?.doi) }
].filter((row) => row.value);

const summaryForPublication = (entry: Publication) => {
  const entryMetadata = getPublicationMetadata(entry);
  return publicationSummary(entry.data, entryMetadata);
};

const relatedPublications = allPublications
  .filter((entry) => entry.id !== publication.id)
  .map((entry) => {
    const sharedThemes = entry.data.themes.filter((theme) => publication.data.themes.includes(theme)).length;
    return { entry, sharedThemes };
  })
  .filter(({ sharedThemes }) => sharedThemes > 0)
  .sort((a, b) => b.sharedThemes - a.sharedThemes || yearRank(b.entry.data.year) - yearRank(a.entry.data.year) || a.entry.data.title.localeCompare(b.entry.data.title))
  .slice(0, 8);

const publicationBySlug = new Map(allPublications.map((entry) => [entry.id, entry]));
const curatedRelatedPublications = (editorial?.relatedSlugs ?? [])
  .map((slug) => publicationBySlug.get(slug))
  .filter((entry): entry is Publication => entry !== undefined && entry.id !== publication.id);
const curatedRelatedSlugs = new Set(curatedRelatedPublications.map((entry) => entry.id));
const displayedRelatedPublications = [
  ...curatedRelatedPublications,
  ...relatedPublications.map(({ entry }) => entry).filter((entry) => !curatedRelatedSlugs.has(entry.id))
].slice(0, 5);

const sortedPublications = [...allPublications].sort((a, b) => yearRank(b.data.year) - yearRank(a.data.year) || a.data.title.localeCompare(b.data.title));
const currentIndex = sortedPublications.findIndex((entry) => entry.id === publication.id);
const previousPublication = currentIndex > 0 ? sortedPublications[currentIndex - 1] : undefined;
const nextPublication = currentIndex >= 0 && currentIndex < sortedPublications.length - 1 ? sortedPublications[currentIndex + 1] : undefined;
const siteUrl = "https://andrewreeves.org";
const publicationUrl = `${siteUrl}/research/${publication.id}/`;
const absoluteUrl = (path: string) => new URL(path, siteUrl).toString();
const publicationImage = heroFigure?.src ?? "/images/andrew-reeves-portrait-editorial.jpg";
const publicationImageAlt = heroFigure?.alt ?? `Research by Andrew Reeves: ${publication.data.title}`;
const publicationFigureCaption = publicationFigure?.kind === "poster"
  ? "Fictional AI-generated illustration inspired by this research. Imagery and numbers are illustrative, not research findings."
  : editorial?.figureCaption ?? publicationFigure?.caption;
const doiValue = meaningfulValue(metadata?.doi).replace(/^https?:\/\/doi\.org\//, "");
const doiUrl = doiValue ? `https://doi.org/${doiValue}` : undefined;
const schemaTypeByPublicationType: Record<string, string> = {
  Article: "ScholarlyArticle",
  Chapter: "Chapter",
  "Working Paper": "ScholarlyArticle",
  Review: "Review",
  Book: "Book"
};
const publicationStructuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": schemaTypeByPublicationType[publication.data.type] ?? "CreativeWork",
      "@id": `${publicationUrl}#publication`,
      headline: publication.data.title,
      name: publication.data.title,
      description: contribution,
      abstract: abstract || undefined,
      url: publicationUrl,
      image: absoluteUrl(publicationImage),
      datePublished: typeof publication.data.year === "number" ? String(publication.data.year) : undefined,
      author: authors.map((name) => ({
        "@type": "Person",
        name
      })),
      publisher: publication.data.type === "Book" && venue
        ? { "@type": "Organization", name: venue }
        : undefined,
      isPartOf: publication.data.type !== "Book" && venue
        ? {
            "@type": "Periodical",
            name: venue
          }
        : undefined,
      pagination: meaningfulValue(metadata?.pages) || undefined,
      identifier: doiValue
        ? {
            "@type": "PropertyValue",
            propertyID: "DOI",
            value: doiValue,
            url: doiUrl
          }
        : undefined,
      sameAs: Array.from(new Set([
        doiUrl,
        ...primaryLinks.map((link) => link.url).filter((url) => /^https?:\/\//.test(url))
      ].filter(Boolean))),
      citation: fullCitation || undefined,
      keywords: visibleThemes,
      about: visibleThemes.map((theme) => ({
        "@type": "Thing",
        name: theme
      })),
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": publicationUrl
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${publicationUrl}#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${siteUrl}/`
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Research",
          item: `${siteUrl}/research/`
        },
        {
          "@type": "ListItem",
          position: 3,
          name: publication.data.title,
          item: publicationUrl
        }
      ]
    }
  ]
};
---

<BaseLayout
  title={`${publication.data.title} | Research`}
  active="Research"
  description={contribution}
  image={publicationImage}
  imageAlt={publicationImageAlt}
  ogType={publication.data.type === "Article" ? "article" : "website"}
  structuredData={publicationStructuredData}
>
  <Fragment slot="head">
    {citationTags.map(({ name, content }) => <meta name={name} content={content} />)}
  </Fragment>
  <article class="publication-profile container-wide">
    <header class:list={["publication-profile-hero", heroFigure && "publication-profile-hero-with-figure"]}>
      <div class="publication-profile-main">
        <div class="publication-profile-meta">
          <p>{publication.data.type} · {publication.data.year}</p>
          <p>{venue}</p>
        </div>
        <h1>{publication.data.title}</h1>
        <p class="publication-contribution">{contribution}</p>
        <p class="publication-profile-authors">{formatAuthors(authors)}</p>
        {primaryLinks.length > 0 && (
          <nav class="publication-primary-links" aria-label="Publication links">
            {primaryLinks.map((link) => (
              <a href={link.url}>{link.label}</a>
            ))}
          </nav>
        )}
        {publication.data.resourceNote && (
          <p class="publication-resource-note">{publication.data.resourceNote} <a href="/contact/">Ask about replication materials.</a></p>
        )}
      </div>
      {heroFigure && (
        <figure class="publication-hero-figure">
          <ResponsiveImage src={heroFigure.src} alt={heroFigure.alt} loading="eager" sizes="(max-width: 760px) 300px, (min-width: 1200px) 355px, 30vw" />
          {publicationFigureCaption && <figcaption>{publicationFigureCaption}</figcaption>}
        </figure>
      )}
    </header>

    {abstract && (
      <details class="publication-profile-abstract" open>
        <summary>Full Abstract</summary>
        <p>{abstract}</p>
      </details>
    )}

    {(publicationThemeLinks.length > 0 || keywordThemes.length > 0) && (
      <nav class="publication-theme-ribbon" aria-label="Related research themes and keywords">
        {publicationThemeLinks.length > 0 && (
          <div class="publication-theme-group">
            <p>Research Themes</p>
            <div>
              {publicationThemeLinks.map((theme) => (
                <a href={themeHref(theme)}>{theme}</a>
              ))}
            </div>
          </div>
        )}
        {keywordThemes.length > 0 && (
          <div class="publication-theme-group">
            <p>Keywords</p>
            <div>
              {keywordThemes.map((theme) => (
                <a href={themeHref(theme)}>{theme}</a>
              ))}
            </div>
          </div>
        )}
      </nav>
    )}

    {contextParagraphs.length > 0 && (
      <section class="publication-profile-section">
        <div class="publication-profile-section-label">
          <h2>{isReview ? "About the Review" : publication.data.type === "Book" ? "About the Book" : "About the Research"}</h2>
        </div>
        <div class="publication-profile-section-body publication-essay">
          {contextParagraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </section>
    )}

    {keyFindings.length > 0 && (
      <section class="publication-profile-section">
        <div class="publication-profile-section-label">
          <h2>{isReview ? "Evidence Discussed in the Book" : "Findings"}</h2>
        </div>
        <div class="publication-profile-section-body">
          <ul class="publication-finding-list">
            {keyFindings.map((finding) => (
              <li>{finding}</li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {designRows.length > 0 && (
      <section class="publication-profile-section">
        <div class="publication-profile-section-label">
          <h2>{isReview ? "Review Format and Sources" : "Research Design"}</h2>
        </div>
        <div class="publication-profile-section-body">
          <dl class="publication-design-grid">
            {designRows.map((row) => (
              <div>
                <dt>{row.label}</dt>
                <dd>{row.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )}

    {(fullCitation || citationRows.length > 0) && (
      <section class="publication-profile-section publication-citation-section">
        <div class="publication-profile-section-label">
          <h2>Citation</h2>
        </div>
        <div class="publication-profile-section-body">
          {fullCitation && (
            <div class="publication-citation-copy">
              <p>{fullCitation}</p>
            </div>
          )}
          <div class="publication-citation-copy publication-citation-actions">
            {fullCitation && <button type="button" data-copy-text={fullCitation} aria-live="polite" hidden>Copy citation</button>}
            <button type="button" data-copy-text={bibtex} aria-live="polite" hidden>Copy BibTeX</button>
          </div>
          <details class="publication-bibtex">
            <summary>View BibTeX</summary>
            <pre><code>{bibtex}</code></pre>
          </details>
          {citationRows.length > 0 && (
            <dl class="publication-citation-grid">
              {citationRows.map((row) => (
                <div>
                  <dt>{row.label}</dt>
                  <dd>{row.value}</dd>
                </div>
              ))}
            </dl>
          )}
        </div>
      </section>
    )}

    {supplementalPoster && (
      <details class="publication-illustration">
        <summary>View an illustration inspired by this research</summary>
        <figure>
          <ResponsiveImage src={supplementalPoster.src} alt={supplementalPoster.alt} loading="lazy" sizes="(max-width: 400px) calc(100vw - 40px), 320px" />
          <figcaption>{publicationFigureCaption}</figcaption>
        </figure>
      </details>
    )}

    {displayedRelatedPublications.length > 0 && (
      <section class="publication-profile-section publication-related-section">
        <div class="publication-profile-section-label">
          <h2>Related Research</h2>
        </div>
        <div class="publication-profile-section-body">
          <div class="publication-related-list">
            {displayedRelatedPublications.map((entry) => (
              <article class="publication-related-item">
                <p>{entry.data.year} · {entry.data.venue}</p>
                <h3><a href={`/research/${entry.id}/`}>{entry.data.title}</a></h3>
                <p>{summaryForPublication(entry)}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <nav class="publication-neighbors publication-neighbors-quiet" aria-label="Publication navigation">
      {previousPublication ? (
        <a href={`/research/${previousPublication.id}/`}>
          <span>Newer</span>
          {previousPublication.data.title}
        </a>
      ) : (
        <span></span>
      )}
      {nextPublication ? (
        <a href={`/research/${nextPublication.id}/`}>
          <span>Older</span>
          {nextPublication.data.title}
        </a>
      ) : (
        <span></span>
      )}
    </nav>
  </article>

  <script>
    const copyCitationText = async (citation: string) => {
      if (navigator.clipboard?.writeText) {
        try {
          await navigator.clipboard.writeText(citation);
          return true;
        } catch {
          // Fall back to the older copy path below.
        }
      }

      const textarea = document.createElement("textarea");
      textarea.value = citation;
      textarea.setAttribute("readonly", "");
      textarea.style.position = "fixed";
      textarea.style.top = "-9999px";
      document.body.append(textarea);
      textarea.select();
      const legacyCopy = (document as Document & { execCommand?: (commandId: string) => boolean }).execCommand;
      const copied = legacyCopy?.call(document, "copy") ?? false;
      textarea.remove();
      return copied;
    };

    document.querySelectorAll<HTMLButtonElement>("[data-copy-text]").forEach((button) => {
      button.hidden = false;
      button.addEventListener("click", async () => {
        const citation = button.dataset.copyText ?? "";
        if (!citation) return;

        const originalText = button.textContent ?? "Copy citation";
        const copied = await copyCitationText(citation);
        button.textContent = copied ? "Copied" : "Copy unavailable";
        window.setTimeout(() => {
          button.textContent = originalText;
        }, 1800);
      });
    });
  </script>
</BaseLayout>
