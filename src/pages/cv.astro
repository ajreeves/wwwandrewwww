---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHeader from "@components/PageHeader.astro";
---

<BaseLayout title="CV" active="CV" description="Curriculum vitae for Andrew Reeves.">
  <PageHeader
    title="Curriculum vitae"
    intro="Last updated October 2, 2026."
    actionHref="/reevescv.pdf"
    actionLabel="Download CV (PDF)"
    compact
  />

  <section class="container-wide page-section cv-preview-section">
    <div class="cv-frame">
      <iframe
        src="/reevescv.pdf#view=FitH&navpanes=0&toolbar=0"
        title="Andrew Reeves curriculum vitae PDF"
        class="h-[72vh] min-h-[620px] w-full"
        loading="lazy"
      ></iframe>
    </div>
  </section>
</BaseLayout>

<style>
  .cv-preview-section { padding-top: 8px; }
  @media (max-width: 640px) {
    .cv-preview-section { display: none; }
  }
</style>
