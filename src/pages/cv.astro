---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHeader from "@components/PageHeader.astro";
import CvPreview from "@components/CvPreview.astro";
---

<BaseLayout title="Curriculum Vitae" active="CV" description="Curriculum vitae for Andrew Reeves.">
  <PageHeader
    title="Curriculum vitae"
    intro="Last updated October 2, 2026."
    actionHref="/reevescv.pdf"
    actionLabel="Download CV (PDF)"
    compact
  />

  <section class="container-wide page-section cv-preview-section">
    <div class="cv-frame">
      <CvPreview />
    </div>
  </section>
</BaseLayout>

<style>
  .cv-preview-section { padding-top: 8px; }
  @media (max-width: 640px) {
    .cv-preview-section { display: none; }
  }
</style>
