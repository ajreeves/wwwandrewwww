---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHeader from "@components/PageHeader.astro";
import StudentCard from "@components/StudentCard.astro";
import {
  doctoralStudents,
  type StudentRecord,
  undergraduateHonorsNote,
  undergraduateHonorsTheses
} from "@data/doctoralStudents";

const publications = await getCollection("publications");
const publicationBySlug = new Map(publications.map((publication) => [publication.id, publication]));

const getPublication = (slug: string) => {
  const publication = publicationBySlug.get(slug);
  if (!publication) {
    throw new Error(`Missing publication for Students page: ${slug}`);
  }
  return publication;
};

const newestFirst = (a: StudentRecord, b: StudentRecord) => {
  const yearA = typeof a.year === "number" ? a.year : 9999;
  const yearB = typeof b.year === "number" ? b.year : 9999;
  return yearB - yearA || a.name.localeCompare(b.name);
};
const sortedDoctoralStudents = [...doctoralStudents].sort(newestFirst);
const sortedUndergraduateTheses = [...undergraduateHonorsTheses].sort(newestFirst);

const tocLinks = [
  { href: "#doctoral-students-heading", label: "Doctoral students" },
  { href: "#undergraduate-theses-heading", label: "Undergraduate honors theses" }
] as const;

---

<BaseLayout
  title="Students"
  active="Students"
  description="Mentorship, advising and student research."
>
  <div class="students-opening">
    <PageHeader
      title="Students"
      intro="Doctoral and undergraduate students advised by Andrew Reeves, with their research, collaborative work and professional profiles."
      compact
    />
  </div>

  <nav class="container-wide page-toc" aria-label="On this page">
    <div>
      {tocLinks.map((item) => <a href={item.href}>{item.label}</a>)}
    </div>
  </nav>

  <section class="container-wide page-section student-page-frame" aria-labelledby="doctoral-students-heading">
    <div class="page-section-heading">
      <h2 id="doctoral-students-heading">Doctoral students</h2>
    </div>

    <div class="student-card-list">
      {sortedDoctoralStudents.map((student) => (
        <StudentCard student={student} publications={(student.related_publications ?? []).map(getPublication)} />
      ))}
    </div>
  </section>

  <section class="container-wide page-section student-page-frame student-undergraduate-frame" aria-labelledby="undergraduate-theses-heading">
    <div class="page-section-heading">
      <h2 id="undergraduate-theses-heading">Undergraduate honors theses</h2>
    </div>

    {
      undergraduateHonorsTheses.length > 0 ? (
        <div class="student-card-list">
          {sortedUndergraduateTheses.map((student) => <StudentCard student={student} />)}
        </div>
      ) : (
        <div class="student-empty-note">
          <p>{undergraduateHonorsNote}</p>
        </div>
      )
    }
  </section>
</BaseLayout>

<script>
  // Measure natural card heights without moving DOM nodes or changing tab order.
  // Ordinary grid rows remain the fallback when ResizeObserver is unavailable.
  if ("ResizeObserver" in window) {
    const lists = [...document.querySelectorAll<HTMLElement>(".student-card-list")];
    let frame = 0;

    const updateSpans = () => {
      frame = 0;
      const measurements = lists.flatMap((list) => {
        const styles = getComputedStyle(list);
        const gap = parseFloat(styles.columnGap);
        const rowHeight = parseFloat(styles.getPropertyValue("--student-card-row-height"));
        return [...list.querySelectorAll<HTMLElement>(".student-card")].map((card) => ({
          card,
          span: String(Math.ceil((card.getBoundingClientRect().height + gap) / rowHeight))
        }));
      });
      for (const { card, span } of measurements) {
        card.style.setProperty("--student-card-span", span);
      }
      for (const list of lists) list.dataset.stacked = "true";
    };

    const scheduleLayout = () => {
      if (!frame) frame = requestAnimationFrame(updateSpans);
    };
    const observer = new ResizeObserver(scheduleLayout);
    for (const list of lists) {
      for (const card of list.querySelectorAll<HTMLElement>(".student-card")) observer.observe(card);
    }
    scheduleLayout();
  }
</script>

<style>
  .students-opening :global(.page-opening) { padding-block: clamp(1.5rem, 3vw, 2.5rem); }
  .students-opening :global(.page-opening-panel) { min-height: 0; padding: clamp(1.25rem, 2.5vw, 2rem); }
  .students-opening :global(.page-opening-panel > .kicker) { margin-bottom: 0.65rem; }
  .students-opening :global(.page-intro) { margin-top: 0.8rem; font-size: clamp(1.05rem, 1.4vw, 1.25rem); line-height: 1.5; }
  .student-page-frame .page-section-heading { display: block; border-top: 0; margin-bottom: 1.5rem; padding-top: 1.5rem; }
  .student-page-frame .page-section-heading h2 { max-width: none; font-size: clamp(1.8rem, 3vw, 2.6rem); line-height: 1.15; }
  .student-card-list {
    --student-card-row-height: 4px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: 1rem;
    margin-top: 0;
  }
  @media (min-width: 1001px) {
    .student-card-list[data-stacked] {
      grid-auto-rows: var(--student-card-row-height);
      grid-auto-flow: row; /* Sparse placement preserves top-to-bottom, left-to-right order. */
      row-gap: 0;
    }
    .student-card-list[data-stacked] > :global(.student-card) {
      grid-row-end: span var(--student-card-span);
    }
  }
  @media (max-width: 1000px) {
    .student-card-list { grid-template-columns: minmax(0, 1fr); }
  }
</style>
