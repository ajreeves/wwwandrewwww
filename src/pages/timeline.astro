---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHeader from "@components/PageHeader.astro";
import Timeline from "@components/Timeline.astro";

const entries = (await getCollection("timeline")).sort((a, b) => b.data.year - a.data.year);
---

<BaseLayout title="Timeline" description="Major books, articles, leadership roles, and institutional milestones in Andrew Reeves's work.">
  <PageHeader
    eyebrow="Milestones & Roles"
    title="Career Milestones"
    intro="A selective chronology of books, articles, and leadership roles documented in the current CV."
  />
  <Timeline entries={entries} />
</BaseLayout>
