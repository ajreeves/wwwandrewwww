---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHeader from "@components/PageHeader.astro";
import FeatureBand from "@components/FeatureBand.astro";
import { contentAnchor } from "../utils/content-anchors";
import { courses, courseArchive } from "@data/teaching";

const awards = [
  {
    title: "David Hadas Teaching Award",
    text: "Awarded for exceptional commitment to first-year undergraduate teaching. Washington University Arts & Sciences, 2021.",
    url: "https://insideartsci.wustl.edu/david-hadas-teaching-award",
    link: "Washington University Arts & Sciences"
  },
  {
    title: "Delores K. Kennedy Award",
    text: "Awarded for commitment to students in the first-year experience. Washington University Political Science, 2018.",
    url: "https://polisci.wustl.edu/news/prof-andrew-reeves-wins-delores-k-kennedy-award#:~:text=This%20award%20recognizes%20a%20member,in%20Introduction%20to%20American%20Politics.",
    link: "Washington University Political Science"
  }
] as const;

const tocLinks = [
  { href: "#classroom-practice", label: "In the classroom" },
  { href: "#featured-courses", label: "Courses" },
  { href: "#teaching-awards", label: "Teaching awards" },
  { href: "#course-archive", label: "Past courses" }
] as const;

const videoWatchUrl = (url: string) => url.replace("/embed/", "/watch?v=");
---

<BaseLayout title="Teaching American Politics" active="Teaching" description="Teaching by Andrew Reeves in American politics, democratic citizenship, and electoral strategy.">
  <PageHeader
    title="Teaching"
    actionHref="/students/"
    actionLabel="Students and advising"
  />

  <nav class="container-wide page-toc" aria-label="On this page">
    <div>
      {tocLinks.map((item) => <a href={item.href}>{item.label}</a>)}
    </div>
  </nav>

  <FeatureBand
    id="classroom-practice"
    title="In the classroom"
    text="In The Practice of Citizenship, students read political theory alongside research on trust, polarization, and civic education."
    image="/images/andrew-teaching-page.jpg"
    alt="Andrew Reeves teaching in a classroom"
  />

  <section id="featured-courses" class="container-wide page-section">
    <div class="page-section-heading">
      <div>
        <h2>Courses</h2>
        <p class="mt-4 max-w-3xl text-xl leading-[1.55] text-muted">Selected undergraduate courses. Dates identify the linked syllabus or a past offering.</p>
      </div>
    </div>
    <div class="teaching-course-list">
      {courses.map((course) => (
        <article id={contentAnchor("course", course.title)} class="teaching-course">
          <div class="teaching-course-heading">
            <h3>{course.title}</h3>
            <p class="teaching-course-term">{course.termLabel} · {course.term}</p>
            <div class="course-action-row">
              {course.links.map((link) => <a class="ghost-button" href={link.url} aria-label={`${link.label}: ${course.title}`}>{link.label}</a>)}
              {course.video && <a class="ghost-button" href={videoWatchUrl(course.video)} aria-label={`Course video: ${course.title}`}>Course video</a>}
            </div>
          </div>
          <div class="teaching-course-description">
            {course.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="teaching-awards" class="container-wide page-section">
    <div class="page-section-heading">
      <div>
        <h2>Teaching awards</h2>
      </div>
    </div>
    <div class="grid gap-5 lg:grid-cols-2">
      {
        awards.map((award) => (
          <article class="editorial-card">
            <p class="kicker mb-4">{award.link}</p>
            <h3 class="card-title">{award.title}</h3>
            <p class="mt-4 text-lg leading-[1.6] text-muted">{award.text}</p>
            <a class="ghost-button mt-3" href={award.url}>Award announcement</a>
          </article>
        ))
      }
    </div>
  </section>

  <section id="course-archive" class="container-wide page-section">
    <div class="page-section-heading">
      <div>
        <h2>Past courses</h2>
      </div>
    </div>
    <div class="grid gap-5 lg:grid-cols-2">
      <article class="editorial-card">
        <p class="kicker mb-4">Undergraduate</p>
        <ul class="space-y-3 text-lg leading-[1.55] text-muted">
          {courseArchive.undergraduate.map((course) => <li>{course}</li>)}
        </ul>
      </article>
      <article class="editorial-card">
        <p class="kicker mb-4">Graduate</p>
        <ul class="space-y-3 text-lg leading-[1.55] text-muted">
          {courseArchive.graduate.map((course) => <li>{course}</li>)}
        </ul>
      </article>
    </div>
  </section>
</BaseLayout>
