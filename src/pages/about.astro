---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHeader from "@components/PageHeader.astro";
import { academicAppointment } from "@data/academic-appointment";

import { galleryPhotos } from "@data/about-gallery";
import ResponsiveImage from "@components/ResponsiveImage.astro";
---

<BaseLayout
  title="About"
  active="About"
  description={`Biography of Andrew Reeves, ${academicAppointment.descriptionTitle} at Washington University in St. Louis.`}
>
  <PageHeader
    eyebrow="Biography"
    title="About Andrew Reeves"
    intro="Political scientist at Washington University in St. Louis."
    compact
  />

  <section class="container-wide page-section about-page">
    <div class="about-introduction">
      <div class="editorial-prose about-lead-prose">
        <p>
          Andrew Reeves is {academicAppointment.biographyRole} at Washington University in St. Louis. He studies presidential power, federal spending, and how people judge their elected leaders. His research examines why some communities receive more government resources than others and how people&rsquo;s experiences with public policy shape their political views.
        </p>
      </div>
      <section
        class="about-photo-gallery"
        aria-label="Photographs of Andrew Reeves"
        aria-roledescription="carousel"
        data-about-gallery
      >
        <div class="about-photo-stage" aria-live="off">
          {
            galleryPhotos.map((photo, index) => (
              <figure class:list={["about-profile-photo", index === 0 && "is-active"]} data-gallery-slide aria-hidden={index === 0 ? "false" : "true"}>
                <div class="about-photo-media">
                  {index === 0 ? (
                    <ResponsiveImage src={photo.src} alt={photo.alt} sizes="(min-width: 1200px) 660px, (min-width: 900px) 54vw, calc(100vw - 40px)" loading="eager" fetchpriority="high" />
                  ) : (
                    <template data-gallery-image>
                      <ResponsiveImage src={photo.src} alt={photo.alt} sizes="(min-width: 1200px) 660px, (min-width: 900px) 54vw, calc(100vw - 40px)" loading="eager" />
                    </template>
                  )}
                </div>
                <figcaption>{photo.caption}</figcaption>
              </figure>
            ))
          }
        </div>
        <div class="about-gallery-controls">
          <div class="about-gallery-nav" aria-label="Choose a photograph">
            <button class="about-gallery-arrow" type="button" data-gallery-previous aria-label="Show previous photograph">←</button>
            {
              galleryPhotos.map((_, index) => (
                <button
                  class:list={["about-gallery-dot", index === 0 && "is-active"]}
                  type="button"
                  data-gallery-dot={index}
                  aria-label={`Show photograph ${index + 1}`}
                  aria-current={index === 0 ? "true" : undefined}
                />
              ))
            }
            <button class="about-gallery-arrow" type="button" data-gallery-next aria-label="Show next photograph">→</button>
          </div>
          <button class="about-gallery-pause" type="button" data-gallery-pause aria-pressed="false">Pause</button>
        </div>
      </section>

    </div>

    <article class="editorial-prose about-biography">
      <p>
        In <a href="https://www.cambridge.org/core/books/no-blank-check/0FE4E2FC0D017DC70566FDFE94B89007"><em>No Blank Check</em></a>, Reeves and Jon C. Rogowski show that Americans care about how presidents use their authority, as well as what they accomplish. In <a href="https://www.cambridge.org/core/books/particularistic-president/1C2686B436BCBFAB3D46EDBD7C2A17C3"><em>The Particularistic President</em></a>, Reeves and Douglas L. Kriner examine how party politics and elections shape federal spending. The book won the 2016 Richard E. Neustadt Award. Reeves&rsquo;s research has appeared in the <em>American Political Science Review</em>, <em>American Journal of Political Science</em>, and <em>Journal of Politics</em>.
      </p>

      <p>
        Reeves directs the <a href="https://wc.wustl.edu/">Weidenbaum Center</a> at WashU. The center supports social science research and hosts discussions with scholars, policymakers, and civic leaders.
      </p>

      <p>
        He also directs the <a href="https://frick.washu.edu/">Frick Initiatives</a>, which supports programs and partnerships at WashU and in the wider community.
      </p>

      <p>
        Reeves also serves as Professor of Law by courtesy at WashU, Senior Advisor to the Chancellor, and a Visiting Fellow at the Hoover Institution. He received his PhD from the Department of Government at Harvard University.
      </p>
    </article>
  </section>

  <script>
    const gallery = document.querySelector<HTMLElement>("[data-about-gallery]");

    if (gallery) {
      const slides = Array.from(gallery.querySelectorAll<HTMLElement>("[data-gallery-slide]"));
      const dots = Array.from(gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-dot]"));
      const pauseButton = gallery.querySelector<HTMLButtonElement>("[data-gallery-pause]");
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      let current = 0;
      let paused = reduceMotion;
      let pausedBeforePointer = paused;
      let timer: number | undefined;

      const loadSlide = (index: number) => {
        const slide = slides[(index + slides.length) % slides.length];
        const template = slide.querySelector<HTMLTemplateElement>("[data-gallery-image]");
        if (template) template.replaceWith(template.content.cloneNode(true));
        return slide.querySelector<HTMLImageElement>("img");
      };

      const showSlide = async (next: number) => {
        current = (next + slides.length) % slides.length;
        const requested = current;
        const image = loadSlide(current);
        await image?.decode().catch(() => {});
        if (current !== requested) return;
        slides.forEach((slide, index) => {
          const active = index === current;
          slide.classList.toggle("is-active", active);
          slide.setAttribute("aria-hidden", String(!active));
        });
        dots.forEach((dot, index) => {
          const active = index === current;
          dot.classList.toggle("is-active", active);
          active ? dot.setAttribute("aria-current", "true") : dot.removeAttribute("aria-current");
        });
        loadSlide(current + 1);
      };

      const stopTimer = () => {
        if (timer !== undefined) window.clearInterval(timer);
        timer = undefined;
      };

      const startTimer = () => {
        stopTimer();
        if (!paused && !document.hidden) timer = window.setInterval(() => showSlide(current + 1), 7000);
      };

      const setPaused = (value: boolean) => {
        paused = value;
        if (pauseButton) {
          pauseButton.textContent = paused ? "Play" : "Pause";
          pauseButton.setAttribute("aria-pressed", String(paused));
        }
        startTimer();
      };

      // Stop on focus entry and require an explicit Play action to resume.
      gallery.addEventListener("focusin", (event) => {
        if (!(event.relatedTarget instanceof Node) || !gallery.contains(event.relatedTarget)) setPaused(true);
      });

      gallery.querySelector("[data-gallery-previous]")?.addEventListener("click", () => {
        showSlide(current - 1);
        startTimer();
      });
      gallery.querySelector("[data-gallery-next]")?.addEventListener("click", () => {
        showSlide(current + 1);
        startTimer();
      });
      dots.forEach((dot) => dot.addEventListener("click", () => {
        showSlide(Number(dot.dataset.galleryDot));
        startTimer();
      }));
      pauseButton?.addEventListener("pointerdown", () => { pausedBeforePointer = paused; });
      pauseButton?.addEventListener("click", (event) => {
        setPaused(!(event.detail > 0 ? pausedBeforePointer : paused));
      });
      document.addEventListener("visibilitychange", () => document.hidden ? stopTimer() : startTimer());

      loadSlide(1);
      setPaused(reduceMotion);
    }
  </script>
</BaseLayout>
