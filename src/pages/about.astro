---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHeader from "@components/PageHeader.astro";
import { academicAppointment, currentAcademicTitle } from "@data/academic-appointment";

import { galleryPhotos } from "@data/about-gallery";
import ResponsiveImage from "@components/ResponsiveImage.astro";

const biographyRole = academicAppointment.title === currentAcademicTitle
  ? academicAppointment.descriptionTitle
  : academicAppointment.biographyRole;

const leadPhoto = galleryPhotos.find((photo) => photo.src === "/images/andrew-reeves-research-presentation-2026.jpg")!;
const additionalPhotos = galleryPhotos.filter((photo) => photo !== leadPhoto);
---

<BaseLayout
  title="Biography"
  active="About"
  description={`Biography of Andrew Reeves, ${academicAppointment.descriptionTitle} at Washington University in St. Louis.`}
>
  <PageHeader
    title="About Andrew Reeves"
    compact
  />

  <section class="container-wide page-section about-page">
    <div class="about-introduction">
      <div class="editorial-prose about-lead-prose">
        <p>
          Andrew Reeves is {biographyRole} at Washington University in St. Louis.
        </p>
        <p>
          His research asks how presidents use power, why some communities receive more government resources than others, and how people’s experiences with public policy shape their political views.
        </p>
        <nav class="about-links" aria-label="About page links">
          <a href="#biography">Biography</a>
          <a href="/#leadership">University leadership</a>
          <a href="/talks/">Talks and events</a>
          <a href="/contact/">Contact</a>
        </nav>
      </div>
      <figure class="about-lead-photo">
        <ResponsiveImage src={leadPhoto.src} alt={leadPhoto.alt} sizes="(min-width: 1200px) 660px, (min-width: 761px) 54vw, calc(100vw - 40px)" loading="eager" fetchpriority="high" />
        <figcaption>{leadPhoto.caption}</figcaption>
      </figure>

    </div>

    <article id="biography" class="editorial-prose about-biography" aria-labelledby="biography-heading">
      <h2 id="biography-heading">Biography</h2>
      <p>
        In <a href="https://www.cambridge.org/core/books/no-blank-check/0FE4E2FC0D017DC70566FDFE94B89007"><em>No Blank Check</em></a>, Reeves and Jon C. Rogowski show that Americans care about how presidents use their authority, as well as what they accomplish. In <a href="https://www.cambridge.org/core/books/particularistic-president/1C2686B436BCBFAB3D46EDBD7C2A17C3"><em>The Particularistic President</em></a>, Reeves and Douglas L. Kriner examine how party politics and elections shape federal spending. The book won the 2016 Richard E. Neustadt Award. Reeves&rsquo;s research has appeared in the <em>American Political Science Review</em>, <em>American Journal of Political Science</em>, and <em>Journal of Politics</em>.
      </p>

      <p>
        Reeves directs the <a href="https://wc.washu.edu/">Weidenbaum Center on the Economy, Government, and Public Policy</a> at WashU. The center supports social science research and hosts discussions with scholars, policymakers, and civic leaders.
      </p>

      <p>
        He also directs the <a href="https://frick.washu.edu/">Frick Initiatives</a>, which support translational research, teaching, and community projects on civil discourse, free speech, free and open markets, and personal responsibility. The initiative expanded through a $22 million commitment from Robert and Barbara Frick.
      </p>

      <p>
        As senior advisor to the chancellor, Reeves also co-chairs the <a href="https://source.washu.edu/2026/09/the-university-challenge/">Ordered Liberty Project</a>, supporting free inquiry and debate across the university.
      </p>

      <p>
        He serves as professor of law by courtesy at WashU and a visiting fellow at the Hoover Institution. He received his PhD from the Department of Government at Harvard University.
      </p>
    </article>

    <details class="about-gallery-disclosure">
      <summary>Teaching, talks, and conversations</summary>
      <section class="about-photo-gallery" aria-label="Photographs of Andrew Reeves" aria-roledescription="carousel" data-about-gallery>
        <div class="about-photo-stage" aria-live="polite" aria-atomic="true">
          {additionalPhotos.map((photo, index) => (
            <figure class:list={["about-profile-photo", index === 0 && "is-active"]} data-gallery-slide aria-hidden={index === 0 ? "false" : "true"}>
              <div class="about-photo-media">
                {index === 0 ? (
                  <ResponsiveImage src={photo.src} alt={photo.alt} sizes="(min-width: 760px) 680px, calc(100vw - 40px)" loading="lazy" />
                ) : (
                  <template data-gallery-image>
                    <ResponsiveImage src={photo.src} alt={photo.alt} sizes="(min-width: 760px) 680px, calc(100vw - 40px)" loading="eager" />
                  </template>
                )}
              </div>
              <figcaption>{photo.caption}</figcaption>
            </figure>
          ))}
        </div>
        <div class="about-gallery-controls" data-gallery-controls hidden>
          <button type="button" data-gallery-previous aria-label="Show previous photograph">Previous</button>
          <span data-gallery-status aria-live="polite" aria-atomic="true">1 of {additionalPhotos.length}</span>
          <button type="button" data-gallery-next aria-label="Show next photograph">Next</button>
        </div>
        <noscript>
          <ul>{additionalPhotos.slice(1).map((photo) => <li><a href={photo.src}>{photo.caption}</a></li>)}</ul>
        </noscript>
      </section>
    </details>
  </section>

  <script>
    const gallery = document.querySelector<HTMLElement>("[data-about-gallery]");

    if (gallery) {
      const slides = Array.from(gallery.querySelectorAll<HTMLElement>("[data-gallery-slide]"));
      const controls = gallery.querySelector<HTMLElement>("[data-gallery-controls]");
      const status = gallery.querySelector<HTMLElement>("[data-gallery-status]");
      let current = 0;
      if (controls) controls.hidden = false;

      const loadSlide = (index: number) => {
        const slide = slides[(index + slides.length) % slides.length];
        const template = slide.querySelector<HTMLTemplateElement>("[data-gallery-image]");
        if (template) template.replaceWith(template.content.cloneNode(true));
        return slide.querySelector<HTMLImageElement>("img");
      };

      const showSlide = async (next: number) => {
        current = (next + slides.length) % slides.length;
        const requested = current;
        const image = loadSlide(current);
        await image?.decode().catch(() => {});
        if (current !== requested) return;
        slides.forEach((slide, index) => {
          const active = index === current;
          slide.classList.toggle("is-active", active);
          slide.setAttribute("aria-hidden", String(!active));
        });
        if (status) status.textContent = `${current + 1} of ${slides.length}`;
      };

      gallery.querySelector("[data-gallery-previous]")?.addEventListener("click", () => showSlide(current - 1));
      gallery.querySelector("[data-gallery-next]")?.addEventListener("click", () => showSlide(current + 1));
    }
  </script>
</BaseLayout>
