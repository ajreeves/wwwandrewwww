---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import ResponsiveImage from "@components/ResponsiveImage.astro";
import responsiveImages from "@data/responsive-images.json";
import { yearRank } from "../utils/publications";
import { academicAppointment } from "@data/academic-appointment";
import { leadershipRoles } from "@data/leadership";
import { researchTopicPath } from "@data/research-topics";
import { publicationSearchEntry } from "../utils/publication-records";

import "../styles/home.css";

const books = (await getCollection("books")).sort((a, b) => yearRank(b.data.year) - yearRank(a.data.year));
// Short homepage treatments; publication pages and citations retain full titles.
const articleNotes: Record<string, { title?: string; finding: string }> = {
  "municipal-administration": { finding: "Elected municipal clerks report focusing more on residents’ needs than appointed clerks do." },
  "private-funding": { finding: "Americans are wary of private election funding; arguments for and against bans change opinion only modestly." },
  "rising-seas": { title: "Rising Seas, Rising Concerns", finding: "Sea-level vulnerability is associated with greater support for climate mitigation, especially among residents strongly attached to their communities." },
  "short-haul-moves": { title: "Short-Haul Moves and the Political Geography of Partisanship", finding: "Short moves within metropolitan areas contribute modestly to partisan geographic sorting." }
};
const recentArticles = (await getCollection("publications"))
  .filter((entry) => entry.data.type === "Article" && /^\d{4}$/.test(String(entry.data.year)))
  .sort((a, b) => yearRank(b.data.year) - yearRank(a.data.year) || a.data.title.localeCompare(b.data.title))
  .slice(0, 3)
  .map((entry) => ({ ...publicationSearchEntry(entry), venue: entry.data.venue, note: articleNotes[entry.id] }));
const bookNotes: Record<string, string> = {
  "no-blank-check": "Americans care how presidents use power, even when they support the policy. Acting without Congress can carry political costs.",
  "particularistic-president": "Presidents govern the whole country, but their electoral incentives favor some places over others. Federal spending reveals the political geography of presidential representation."
};
const researchAreas = [
  {
    title: "Presidential power",
    href: researchTopicPath("presidential-power")
  },
  {
    title: "Democratic accountability",
    href: researchTopicPath("democratic-accountability")
  },
  {
    title: "Political geography",
    href: researchTopicPath("political-geography")
  },
  {
    title: "Federal spending",
    href: researchTopicPath("federal-resource-allocation")
  }
] as const;

const personStructuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://andrewreeves.org/#andrew-reeves",
  name: "Andrew Reeves",
  url: "https://andrewreeves.org/",
  image: "https://andrewreeves.org/images/editorial/andrew-reeves-portrait.jpg",
  jobTitle: [
    academicAppointment.title,
    "Professor of Law by courtesy",
    "Director, Weidenbaum Center on the Economy, Government, and Public Policy",
    "Director, Frick Initiatives",
    "Senior Advisor to the Chancellor",
    "Co-Chair, Ordered Liberty Project",
    "Visiting Fellow"
  ],
  worksFor: [
    {
      "@type": "CollegeOrUniversity",
      name: "Washington University in St. Louis",
      url: "https://washu.edu/"
    },
    {
      "@type": "Organization",
      name: "Hoover Institution",
      url: "https://www.hoover.org/"
    }
  ],
  affiliation: [
    {
      "@type": "Organization",
      name: "Weidenbaum Center on the Economy, Government, and Public Policy",
      url: "https://wc.washu.edu/"
    },
    {
      "@type": "Organization",
      name: "Frick Initiatives",
      url: "https://frick.washu.edu/"
    }
  ],
  sameAs: [
    "https://scholar.google.com/citations?hl=en&user=xPSRkX4AAAAJ",
    "https://polisci.wustl.edu/people/andrew-reeves/",
    "https://wc.washu.edu/"
  ],
  knowsAbout: [
    "American politics",
    "Presidential power",
    "Democratic accountability",
    "Political geography",
    "Federal resource allocation",
    "Public opinion"
  ]
};
const websiteStructuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://andrewreeves.org/#website",
  name: "Andrew Reeves",
  url: "https://andrewreeves.org/",
  publisher: { "@id": "https://andrewreeves.org/#andrew-reeves" }
};
---

<BaseLayout active="Home" description="Andrew Reeves is a political scientist at Washington University in St. Louis studying presidential power, public accountability, and the geography of federal spending." structuredData={[personStructuredData, websiteStructuredData]}>
  <Fragment slot="head">
    <link rel="stylesheet" href="https://use.typekit.net/dlf3syd.css" />
    <link rel="preload" as="image" href={responsiveImages["/images/editorial/andrew-reeves-portrait.jpg"].src} imagesrcset={responsiveImages["/images/editorial/andrew-reeves-portrait.jpg"].srcset} imagesizes="(max-width: 760px) 112px, 420px" />
  </Fragment>
  <div class="home-page">
    <section class="narrative-opening" aria-labelledby="home-name">
      <div class="narrative-shell narrative-intro">
        <div class="narrative-identity">
          <p class="narrative-label">Political scientist · Washington University in St. Louis</p>
          <h1 id="home-name">Andrew Reeves studies power, place, and accountability in American politics.</h1>
        </div>
        <figure class="narrative-portrait">
          <ResponsiveImage src="/images/editorial/andrew-reeves-portrait.jpg" alt="Portrait of Andrew Reeves" sizes="(max-width: 760px) 112px, 420px" loading="eager" fetchpriority="high" />
        </figure>
        <div class="narrative-credentials">
          <p>He is {academicAppointment.biographyRole} at Washington University in St. Louis.</p>
          <p class="narrative-fellowship">He is also a visiting fellow at the <a href="https://www.hoover.org/">Hoover Institution</a>.</p>
          <nav class="narrative-actions" aria-label="Personal information"><a class="narrative-primary-action" href="/cv/">CV</a><a href="/about/">Biography</a><a href="/contact/">Contact</a></nav>
        </div>
      </div>
    </section>

    <section id="research" class="narrative-shell narrative-research" aria-labelledby="research-heading">
      <h2 id="research-heading" class="narrative-label">Studying presidential power and public accountability</h2>
      <p class="narrative-research-question">His research asks how the public responds when presidents act alone and how electoral incentives shape where federal dollars go.</p>
      <div class="narrative-books">
        {books.map((book) => (
          <article class="narrative-book">
            <a href={`/books/#${book.id}`} class="narrative-book-cover" aria-label={`${book.data.title} book page`}>
              <img src={book.data.cover} alt={`Cover of ${book.data.title}`} width={book.id === "particularistic-president" ? 427 : 415} height="648" loading="lazy" />
            </a>
            <div class="narrative-book-copy">
              <div class="narrative-book-heading"><h3><a href={`/books/#${book.id}`}>{book.data.title}</a></h3>
              <p class="narrative-meta">With {book.data.coauthors.join(" and ")} · {book.data.year}</p></div>
              <p>{bookNotes[book.id] ?? book.data.summary}</p>
            </div>
          </article>
        ))}
      </div>
      <section class="narrative-recent" aria-labelledby="recent-articles-heading">
        <h3 id="recent-articles-heading" class="narrative-label">Recent articles</h3>
        <div class="narrative-card-grid">
          {recentArticles.map((article) => (
            <article class="narrative-card">
              <h4 class="narrative-card-title"><a href={article.url} aria-label={article.note?.title ? article.title : undefined}>{article.note?.title ?? article.title}</a></h4>
              <p class="narrative-meta">{article.venue} · {article.year}</p>
              <p class="narrative-card-description">{article.note?.finding ?? article.summary}</p>
            </article>
          ))}
        </div>
      </section>
      <nav class="narrative-topics" aria-label="Browse research by topic"><span>Browse by topic</span>{researchAreas.map((item) => <a href={item.href}>{item.title}</a>)}</nav>
      <a class="narrative-link" href="/research/">All publications</a>
    </section>

    <section id="leadership" class="narrative-leadership" aria-labelledby="leadership-heading">
      <div class="narrative-shell">
        <div class="narrative-feature">
          <div class="narrative-feature-copy">
            <p class="narrative-label">University leadership</p>
            <h2 id="leadership-heading">Leading research and civic initiatives at WashU</h2>
          </div>
          <figure class="narrative-scene">
            <ResponsiveImage src="/images/andrew-reeves-frick-candid.jpg" alt="Andrew Reeves laughing during a conversation with Bob Frick" sizes="(max-width: 760px) calc(100vw - 40px), 520px" loading="lazy" />
            <figcaption>With Bob Frick at the launch of the Frick Initiatives. Photo: Suzy Gorman.</figcaption>
          </figure>
        </div>
        <div class="narrative-card-grid narrative-leadership-cards">
          {leadershipRoles.map((item) => {
            const isAdvisor = item.id === "chancellor-advisor";
            return (
            <article id={item.id} class="narrative-card" aria-labelledby={`${item.id}-heading`}>
              <p class="narrative-label">{isAdvisor ? "Washington University in St. Louis" : item.role}</p>
              <h3 id={`${item.id}-heading`} class="narrative-card-title">{isAdvisor ? item.role : <a href={item.url}>{item.name}</a>}</h3>
              <p class="narrative-card-description">{item.description}</p>
            </article>
            );
          })}
        </div>
      </div>
    </section>

    <section id="teaching" class="narrative-shell narrative-teaching narrative-feature" aria-labelledby="teaching-heading">
      <figure class="narrative-scene">
        <ResponsiveImage src="/images/andrew-teaching-page.jpg" alt="Andrew Reeves teaching in a classroom at Washington University" sizes="(max-width: 760px) calc(100vw - 40px), 520px" loading="lazy" />
        <figcaption>In the classroom at Washington University.</figcaption>
      </figure>
      <div class="narrative-feature-copy">
        <p class="narrative-label">Teaching</p>
        <h2 id="teaching-heading">Teaching American politics and the responsibilities of citizenship</h2>
        <p>In <em>The Practice of Citizenship</em>, students read political theory alongside research on trust, polarization, and civic education.</p>
        <nav class="narrative-actions" aria-label="Teaching and students"><a href="/teaching/">Courses and syllabi</a><a href="/students/">Students and advising</a></nav>
      </div>
    </section>

    <section id="public-life" class="narrative-shell narrative-public" aria-labelledby="public-heading">
      <div class="narrative-section-intro">
        <p class="narrative-label">Public conversations</p>
        <div><h2 id="public-heading">Discussing politics and public life with scholars and public leaders</h2><p>With Adriana Kugler, then a Federal Reserve governor, he discussed the outlook for the U.S. economy.</p></div>
      </div>
      <figure class="narrative-conversation">
        <ResponsiveImage src="/images/adriana-kugler-andrew-reeves-conversation.jpg" alt="Adriana Kugler in conversation with Andrew Reeves before an audience at a Weidenbaum Center forum" sizes="(max-width: 1200px) calc(100vw - 40px), 1200px" loading="lazy" />
        <figcaption>In conversation with Federal Reserve Governor Adriana D. Kugler, April 2024. Photo: Jerry Naunheim Jr./WashU.</figcaption>
      </figure>
      <nav class="narrative-actions" aria-label="Public conversations"><a href="/talks/">Talks and events</a><a href="/news/">Coverage and commentary</a></nav>
    </section>
  </div>
</BaseLayout>
