---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import BookFeature from "@components/BookFeature.astro";

const yearRank = (year: number | string) => (typeof year === "number" ? year : 9999);
const books = (await getCollection("books")).sort((a, b) => yearRank(b.data.year) - yearRank(a.data.year));
const questions = [
  {
    question: "What can presidents actually do?",
    title: "Presidential Power",
    text: "How presidents lead, especially when acting without Congress, and how public opinion and institutional checks constrain executive discretion.",
    href: "/research/?theme=presidential-power"
  },
  {
    question: "When do citizens assign responsibility?",
    title: "Democratic Accountability",
    text: "When citizens reward or punish leaders, and how visibility, timing, and policy design shape democratic accountability.",
    href: "/research/?theme=democratic-accountability"
  },
  {
    question: "How does place enter national politics?",
    title: "Political Geography",
    text: "How political behavior and government experience differ across urban, suburban, and rural communities, and why those divides shape polarization and representation.",
    href: "/research/?theme=political-geography"
  },
  {
    question: "Where does federal attention go?",
    title: "Federal Resource Allocation",
    text: "How presidents allocate resources across states and communities, with attention to strategic targeting, inequality, and institutional bias.",
    href: "/research/?theme=federal-resource-allocation"
  }
] as const;

interface FeatureTile {
  label: string;
  title: string;
  text: string;
  href: string;
  image: string;
  alt: string;
  width: number;
  height: number;
  srcset?: string;
  sizes?: string;
}

const featureTiles: FeatureTile[] = [
  {
    label: "Research",
    title: "Where resources land",
    text: "How public resources and presidential incentives move across communities.",
    href: "/research/?theme=federal-resource-allocation",
    image: "/images/federal-resource-allocation-map-1200.jpg",
    alt: "Map showing federal resource allocation patterns",
    width: 1200,
    height: 800,
    srcset: "/images/federal-resource-allocation-map-800.jpg 800w, /images/federal-resource-allocation-map-1200.jpg 1200w",
    sizes: "(max-width: 800px) 800px, 1200px"
  },
  {
    label: "Books",
    title: "Limits on power",
    text: "How citizens place limits on unilateral presidential power.",
    href: "/books/#no-blank-check",
    image: "/images/andrew-fed-page.jpg",
    alt: "Andrew Reeves speaking in a public policy setting",
    width: 1800,
    height: 1200
  },
  {
    label: "Teaching",
    title: "Governing and being governed",
    text: "Courses on citizenship, elections, institutions, and political accountability.",
    href: "/teaching/",
    image: "/images/andrew-teaching-page.jpg",
    alt: "Classroom teaching scene",
    width: 1600,
    height: 1067
  }
];

const personStructuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://andrewreeves.org/#andrew-reeves",
  name: "Andrew Reeves",
  url: "https://andrewreeves.org/",
  image: "https://andrewreeves.org/images/andrew-reeves-portrait-editorial.jpg",
  jobTitle: [
    "Professor of Political Science",
    "Professor of Law by courtesy",
    "Director, Weidenbaum Center on the Economy, Government, and Public Policy",
    "Director, The Frick Initiatives",
    "Senior Advisor to the Chancellor",
    "Visiting Fellow"
  ],
  worksFor: [
    {
      "@type": "CollegeOrUniversity",
      name: "Washington University in St. Louis",
      url: "https://washu.edu/"
    },
    {
      "@type": "Organization",
      name: "Hoover Institution",
      url: "https://www.hoover.org/"
    }
  ],
  affiliation: [
    {
      "@type": "Organization",
      name: "Weidenbaum Center on the Economy, Government, and Public Policy",
      url: "https://wc.wustl.edu/"
    },
    {
      "@type": "Organization",
      name: "The Frick Initiatives",
      url: "https://law.washu.edu/frick-initiative/"
    }
  ],
  sameAs: [
    "https://scholar.google.com/citations?hl=en&user=xPSRkX4AAAAJ",
    "https://polisci.wustl.edu/people/andrew-reeves/",
    "https://wc.wustl.edu/"
  ],
  knowsAbout: [
    "American politics",
    "Presidential power",
    "Democratic accountability",
    "Political geography",
    "Federal resource allocation",
    "Public opinion"
  ]
};
---

<BaseLayout active="Home" structuredData={personStructuredData}>
  <section class="home-thesis-hero">
    <div class="home-thesis-copy">
      <h1>Power, place, and accountability in American political life.</h1>
      <p class="home-thesis-lede">
        Reeves studies how presidents act through institutions, how public resources move across communities, and how citizens judge leaders when policy meets lived experience.
      </p>
      <ul class="home-affiliations" aria-label="Appointments and affiliations">
        <li class="affil-item">
          <a class="affil-role" href="https://polisci.wustl.edu/">Professor of Political Science</a>
          <a class="affil-inst" href="https://washu.edu/">Washington University in St. Louis</a>
        </li>
        <li class="affil-item">
          <a class="affil-role" href="https://wc.wustl.edu/">Director, Weidenbaum Center on the Economy, Government, and Public Policy</a>
          <a class="affil-inst" href="https://washu.edu/">Washington University in St. Louis</a>
        </li>
        <li class="affil-item">
          <a class="affil-role" href="https://law.washu.edu/frick-initiative/">Director, The Frick Initiatives</a>
          <a class="affil-inst" href="https://washu.edu/">Washington University in St. Louis</a>
        </li>
        <li class="affil-item">
          <a class="affil-role" href="https://andrewdmartin.washu.edu/">Senior Advisor to the Chancellor</a>
          <a class="affil-inst" href="https://washu.edu/">Washington University in St. Louis</a>
        </li>
        <li class="affil-item affil-item--external">
          <a class="affil-role" href="https://www.hoover.org/">Visiting Fellow</a>
          <a class="affil-inst" href="https://www.hoover.org/">Hoover Institution</a>
        </li>
      </ul>
      <div class="home-thesis-links" aria-label="Primary homepage links">
        <a href="/research/">Explore research</a>
        <a href="/books/">Browse books</a>
      </div>
    </div>
    <figure class="home-thesis-portrait">
      <img
        src="/images/andrew-reeves-portrait-editorial.jpg"
        alt="Portrait of Andrew Reeves"
        loading="eager"
        fetchpriority="high"
        width="1200"
        height="1440"
      />
    </figure>
  </section>

  <section class="home-feature-band" aria-label="Featured site pathways">
    {
      featureTiles.map((item) => (
        <a class="home-feature-tile" href={item.href}>
          <img src={item.image} alt={item.alt} loading="lazy" width={item.width} height={item.height} srcset={item.srcset} sizes={item.sizes} />
          <span class="feature-label">{item.label}</span>
          <strong class="feature-title-v2">{item.title}</strong>
          <span class="feature-text">{item.text}</span>
        </a>
      ))
    }
  </section>

  <section class="home-question-map" aria-labelledby="questions-heading">
    <div class="home-question-heading">
      <p>Questions</p>
      <h2 id="questions-heading">Four questions run through the work.</h2>
    </div>
    <div class="home-question-grid">
      {
        questions.map((item) => (
          <article class="home-question-card">
            <h3>{item.question}</h3>
            <p class="home-question-title">{item.title}</p>
            <p>{item.text}</p>
            <a class="home-question-link" href={item.href}>Related work</a>
          </article>
        ))
      }
    </div>
    <blockquote class="home-research-summary">
      Reeves's research explains how power is exercised, how policy is delivered, and when democratic accountability succeeds or fails.
    </blockquote>
  </section>

  <section class="home-book-spread" aria-labelledby="major-works-heading">
    <div class="home-spread-heading">
      <p>Books</p>
      <h2 id="major-works-heading">These questions are explored most fully in two books.</h2>
    </div>
    <div class="home-book-objects">
      {books.map((book, index) => <BookFeature book={book} reversed={index % 2 === 1} />)}
    </div>
    <a class="home-archive-cta" href="/research/">Explore all publications</a>
  </section>
</BaseLayout>
