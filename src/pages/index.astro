---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import ResponsiveImage from "@components/ResponsiveImage.astro";
import responsiveImages from "@data/responsive-images.json";
import { yearRank } from "../utils/publications";
import { academicAppointment } from "@data/academic-appointment";
import "../styles/home.css";

const books = (await getCollection("books")).sort((a, b) => yearRank(b.data.year) - yearRank(a.data.year));
const recentArticles = (await getCollection("publications"))
  .filter((entry) => entry.data.type === "Article" && /^\d{4}$/.test(String(entry.data.year)))
  .sort((a, b) => yearRank(b.data.year) - yearRank(a.data.year) || a.data.title.localeCompare(b.data.title))
  .slice(0, 4);
const bookNotes: Record<string, string> = {
  "no-blank-check": "How public opinion limits presidents who act without Congress.",
  "particularistic-president": "Why presidents direct more federal resources to some communities than others."
};
const researchAreas = [
  {
    title: "Presidential power",
    href: "/research/?theme=presidential-power"
  },
  {
    title: "Democratic accountability",
    href: "/research/?theme=democratic-accountability"
  },
  {
    title: "Political geography",
    href: "/research/?theme=political-geography"
  },
  {
    title: "Federal spending",
    href: "/research/?theme=federal-resource-allocation"
  }
] as const;

const photoLinks = [
  {
    title: "Research",
    text: "Presidential power, public opinion, and place.",
    href: "/research/",
    image: "/images/andrew-harvard-page.jpg",
    alt: "Andrew Reeves moderating the Election Analyst Panel at Harvard University"
  },
  {
    title: "Teaching",
    text: "American politics, elections, and citizenship.",
    href: "/teaching/",
    image: "/images/andrew-teaching-page.jpg",
    alt: "Andrew Reeves teaching in a classroom"
  },
  {
    title: "Talks and events",
    text: "Weidenbaum Center conversations.",
    href: "/talks/",
    image: "/images/adriana-kugler-andrew-reeves-conversation.jpg",
    alt: "Adriana Kugler in conversation with Andrew Reeves at a Weidenbaum Center forum"
  }
] as const;

const personStructuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://andrewreeves.org/#andrew-reeves",
  name: "Andrew Reeves",
  url: "https://andrewreeves.org/",
  image: "https://andrewreeves.org/images/andrew-reeves-portrait-editorial.jpg",
  jobTitle: [
    academicAppointment.title,
    "Professor of Law by courtesy",
    "Director, Weidenbaum Center on the Economy, Government, and Public Policy",
    "Director, Frick Initiatives",
    "Senior Advisor to the Chancellor",
    "Co-Chair, Ordered Liberty Project",
    "Visiting Fellow"
  ],
  worksFor: [
    {
      "@type": "CollegeOrUniversity",
      name: "Washington University in St. Louis",
      url: "https://washu.edu/"
    },
    {
      "@type": "Organization",
      name: "Hoover Institution",
      url: "https://www.hoover.org/"
    }
  ],
  affiliation: [
    {
      "@type": "Organization",
      name: "Weidenbaum Center on the Economy, Government, and Public Policy",
      url: "https://wc.wustl.edu/"
    },
    {
      "@type": "Organization",
      name: "Frick Initiatives",
      url: "https://frick.washu.edu/"
    }
  ],
  sameAs: [
    "https://scholar.google.com/citations?hl=en&user=xPSRkX4AAAAJ",
    "https://polisci.wustl.edu/people/andrew-reeves/",
    "https://wc.wustl.edu/"
  ],
  knowsAbout: [
    "American politics",
    "Presidential power",
    "Democratic accountability",
    "Political geography",
    "Federal resource allocation",
    "Public opinion"
  ]
};
---

<BaseLayout active="Home" structuredData={personStructuredData}>
  <Fragment slot="head">
    <link rel="preload" as="image" href={responsiveImages["/images/andrew-reeves-portrait-editorial.jpg"].src} imagesrcset={responsiveImages["/images/andrew-reeves-portrait-editorial.jpg"].srcset} imagesizes="(max-width: 760px) 96px, (max-width: 1000px) 240px, 260px" />
  </Fragment>
  <div class="home-page">
    <section class="container-wide home-intro" aria-labelledby="home-name">
      <figure class="home-portrait">
        <ResponsiveImage src="/images/andrew-reeves-portrait-editorial.jpg" alt="Portrait of Andrew Reeves" sizes="(max-width: 760px) 96px, (max-width: 1000px) 240px, 260px" loading="eager" fetchpriority="high" />
      </figure>
      <div class="home-intro-copy">
        <h1 id="home-name">Andrew Reeves is {academicAppointment.biographyRole} at Washington University in St. Louis.</h1>
        <p class="home-intro-lede">He studies American politics: how presidents make decisions, how people judge their leaders, and who benefits from government policy.</p>
        <p class="home-intro-leadership">He directs the <a href="https://wc.wustl.edu/">Weidenbaum Center</a> and the <a href="https://frick.washu.edu/">Frick Initiatives</a>, and serves as Senior Advisor to the Chancellor.</p>
        <div class="home-links" aria-label="Primary homepage links">
          <a href="/research/">Research</a>
          <a href="#leadership">University leadership</a>
          <a href="/about/">Biography</a>
          <a href="/contact/">Contact</a>
        </div>
      </div>
    </section>

    <nav class="home-photo-nav" aria-label="Explore Andrew Reeves’s work">
      {photoLinks.map((item) => (
        <a class="home-photo-link" href={item.href} aria-label={item.title}>
          <ResponsiveImage src={item.image} alt={item.alt} loading="lazy" sizes="(max-width: 760px) 96px, 33vw" />
          <span class="home-photo-copy">
            <span class="home-photo-title">{item.title}</span>
            <span class="home-photo-description">{item.text}</span>
          </span>
        </a>
      ))}
    </nav>

    <section id="leadership" class="container-wide home-leadership" aria-labelledby="leadership-heading">
      <h2 id="leadership-heading">University leadership</h2>
      <div class="home-leadership-copy">
        <dl>
          <div>
            <dt><a href="https://wc.wustl.edu/">Weidenbaum Center</a><span>Director</span></dt>
            <dd>Reeves leads the Center on the Economy, Government, and Public Policy, supporting social science research and bringing scholars, policymakers, and civic leaders into conversation.</dd>
          </div>
          <div>
            <dt><a href="https://frick.washu.edu/">Frick Initiatives</a><span>Director</span></dt>
            <dd>He oversees support for university and community projects on civil discourse, free speech, free and open markets, and personal responsibility.</dd>
          </div>
          <div>
            <dt><a href="https://andrewdmartin.washu.edu/people/">Office of the Chancellor</a><span>Senior Advisor to the Chancellor</span></dt>
            <dd>Reeves also co-chairs the <a href="https://source.washu.edu/2026/09/the-university-challenge/">Ordered Liberty Project</a> with Stefanie Lindquist, supporting free inquiry and debate across the university.</dd>
          </div>
        </dl>
        <p class="home-affiliations">He also serves as <a href="https://law.washu.edu/">Professor of Law by courtesy</a> at WashU and a <a href="https://www.hoover.org/">Visiting Fellow at the Hoover Institution</a>.</p>
      </div>
    </section>

    <section class="container-wide home-books" aria-labelledby="major-works-heading">
      <h2 id="major-works-heading">Books</h2>
      <div class="home-books-pair">
        {books.map((book) => (
          <article class="home-book">
            <a class="home-book-cover" href={`/books/#${book.id}`} aria-label={`${book.data.title} book page`}>
              <img src={book.data.cover} alt={`Cover of ${book.data.title}`} width={book.id === "particularistic-president" ? 427 : 415} height="648" loading="lazy" />
            </a>
            <div class="home-book-copy">
              <h3><a href={`/books/#${book.id}`}>{book.data.title}</a></h3>
              <p class="home-book-author">With {book.data.coauthors.join(" and ")}</p>
              <p>{bookNotes[book.id] ?? book.data.summary}</p>
              <a class="home-text-link" href={`/books/#${book.id}`}>About the book<span class="sr-only">: {book.data.title}</span></a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="container-wide home-recent" aria-labelledby="recent-articles-heading">
      <h2 id="recent-articles-heading">Recent articles</h2>
      <ul>
        {recentArticles.map((article) => (
          <li>
            <h3><a href={`/research/${article.id}/`}>{article.data.title}</a></h3>
            <p>{article.data.venue} · {article.data.year}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="container-wide home-research" aria-labelledby="questions-heading">
      <div>
        <h2 id="questions-heading">Research</h2>
        <a class="home-text-link" href="/research/">All publications</a>
      </div>
      <nav class="home-research-topics" aria-label="Research areas">
        <ul>{researchAreas.map((item) => <li><a href={item.href}>{item.title}</a></li>)}</ul>
      </nav>
    </section>

    <section class="container-wide home-teaching-note" aria-labelledby="public-life-heading">
      <h2 id="public-life-heading">Teaching citizenship</h2>
      <div>
        <p>In Reeves’s Citizenship course, students read Aristotle and Martin Luther King Jr. alongside research on trust and polarization.</p>
        <p>They consider how people learn to take part in democracy and what citizens owe one another.</p>
        <div class="home-links">
          <a href="/teaching/">Courses and syllabi</a>
          <a href="/students/">Students and advising</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
