---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import BookFeature from "@components/BookFeature.astro";
import ResponsiveImage from "@components/ResponsiveImage.astro";
import responsiveImages from "@data/responsive-images.json";
import { yearRank } from "../utils/publications";
import { academicAppointment } from "@data/academic-appointment";

const books = (await getCollection("books")).sort((a, b) => yearRank(b.data.year) - yearRank(a.data.year));
const researchAreas = [
  {
    title: "Presidential power",
    text: "When presidents can act on their own, and how the public responds.",
    href: "/research/?theme=presidential-power"
  },
  {
    title: "Democratic accountability",
    text: "How voters decide whom to credit or blame for government decisions and events.",
    href: "/research/?theme=democratic-accountability"
  },
  {
    title: "Political geography",
    text: "How where people live—and where they move—shapes their political views.",
    href: "/research/?theme=political-geography"
  },
  {
    title: "Federal spending",
    text: "How presidents direct federal resources toward particular states and communities.",
    href: "/research/?theme=federal-resource-allocation"
  }
] as const;

const personStructuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://andrewreeves.org/#andrew-reeves",
  name: "Andrew Reeves",
  url: "https://andrewreeves.org/",
  image: "https://andrewreeves.org/images/andrew-reeves-portrait-editorial.jpg",
  jobTitle: [
    academicAppointment.title,
    "Professor of Law by courtesy",
    "Director, Weidenbaum Center on the Economy, Government, and Public Policy",
    "Director, Frick Initiatives",
    "Senior Advisor to the Chancellor",
    "Visiting Fellow"
  ],
  worksFor: [
    {
      "@type": "CollegeOrUniversity",
      name: "Washington University in St. Louis",
      url: "https://washu.edu/"
    },
    {
      "@type": "Organization",
      name: "Hoover Institution",
      url: "https://www.hoover.org/"
    }
  ],
  affiliation: [
    {
      "@type": "Organization",
      name: "Weidenbaum Center on the Economy, Government, and Public Policy",
      url: "https://wc.wustl.edu/"
    },
    {
      "@type": "Organization",
      name: "Frick Initiatives",
      url: "https://frick.washu.edu/"
    }
  ],
  sameAs: [
    "https://scholar.google.com/citations?hl=en&user=xPSRkX4AAAAJ",
    "https://polisci.wustl.edu/people/andrew-reeves/",
    "https://wc.wustl.edu/"
  ],
  knowsAbout: [
    "American politics",
    "Presidential power",
    "Democratic accountability",
    "Political geography",
    "Federal resource allocation",
    "Public opinion"
  ]
};
---

<BaseLayout active="Home" structuredData={personStructuredData}>
  <Fragment slot="head">
    <link rel="preload" as="image" href={responsiveImages["/images/andrew-reeves-portrait-editorial.jpg"].src} imagesrcset={responsiveImages["/images/andrew-reeves-portrait-editorial.jpg"].srcset} imagesizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1200px) 40vw, 460px" />
  </Fragment>
  <section class="container-wide home-thesis-hero">
    <div class="home-thesis-copy">
      <h1>Andrew Reeves</h1>
      <p class="home-thesis-lede">I’m a political scientist at Washington University in St. Louis. I study the American presidency, public opinion, and the politics of federal spending.</p>
      <ul class="home-affiliations" aria-label="Primary appointment">
        <li class="affil-item affil-item--primary">
          <a class="affil-role" href="https://polisci.wustl.edu/">{academicAppointment.title}</a>
          <a class="affil-inst" href="https://washu.edu/">Washington University in St. Louis</a>
        </li>
      </ul>
      <div class="home-thesis-links" aria-label="Primary homepage links">
        <a href="/research/">Research</a>
        <a href="/about/">More about me</a>
      </div>
    </div>
    <figure class="home-thesis-portrait">
      <ResponsiveImage src="/images/andrew-reeves-portrait-editorial.jpg" alt="Portrait of Andrew Reeves" sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1200px) 40vw, 460px" loading="eager" fetchpriority="high" width="1200" height="1440" />
    </figure>
  </section>

  <aside class="container-wide home-appointments" aria-label="Additional appointments and affiliations">
    <p class="kicker">Other roles</p>
    <ul class="home-affiliations home-secondary-affiliations">
      <li class="affil-item"><a class="affil-role" href="https://wc.wustl.edu/">Director, Weidenbaum Center on the Economy, Government, and Public Policy</a></li>
      <li class="affil-item"><a class="affil-role" href="https://frick.washu.edu/">Director, Frick Initiatives</a></li>
      <li class="affil-item"><a class="affil-role" href="https://law.washu.edu/">Professor of Law by courtesy</a></li>
      <li class="affil-item"><a class="affil-role" href="https://andrewdmartin.washu.edu/">Senior Advisor to the Chancellor</a></li>
      <li class="affil-item"><a class="affil-role" href="https://www.hoover.org/">Visiting Fellow, Hoover Institution</a></li>
    </ul>
  </aside>

  <section class="container-wide home-question-map" aria-labelledby="questions-heading">
    <div class="home-question-heading">
      <h2 id="questions-heading">Research</h2>
    </div>
    <div class="home-question-grid">
      {researchAreas.map((item) => (
        <article class="home-question-card">
          <h3><a href={item.href}>{item.title}</a></h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="container-wide home-book-spread" aria-labelledby="major-works-heading">
    <div class="home-spread-heading">
      <h2 id="major-works-heading">Books</h2>
    </div>
    <div class="home-book-objects">
      {books.map((book) => <BookFeature book={book} />)}
    </div>
  </section>

  <section class="container-wide home-public-life" aria-labelledby="public-life-heading">
    <div class="home-spread-heading">
      <h2 id="public-life-heading">Teaching and talks</h2>
    </div>
    <div class="home-public-life-grid">
      <article>
        <a class="home-story-image" href="/teaching/" aria-label="Teaching"><ResponsiveImage src="/images/andrew-teaching-page.jpg" alt="Andrew Reeves teaching in a classroom" loading="lazy" sizes="(min-width: 1200px) 580px, (min-width: 760px) 46vw, calc(100vw - 40px)" /></a>
        <h3><a href="/teaching/">Teaching</a></h3>
        <p>I teach undergraduate and graduate courses on American politics, elections, and citizenship.</p>
        <a class="home-story-link" href="/students/">Students and advising</a>
      </article>
      <article>
        <a class="home-story-image" href="/talks/" aria-label="Talks and events"><ResponsiveImage src="/images/adriana-kugler-andrew-reeves-conversation.jpg" alt="Adriana Kugler in conversation with Andrew Reeves at a Weidenbaum Center forum" loading="lazy" sizes="(min-width: 1200px) 580px, (min-width: 760px) 46vw, calc(100vw - 40px)" /></a>
        <h3><a href="/talks/">Talks and events</a></h3>
        <p>I host conversations at the Weidenbaum Center with scholars, policymakers, and other guests.</p>
        <a class="home-story-link" href="/news/">Commentary and media coverage</a>
      </article>
    </div>
  </section>
</BaseLayout>
