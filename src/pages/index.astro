---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import ResponsiveImage from "@components/ResponsiveImage.astro";
import responsiveImages from "@data/responsive-images.json";
import { yearRank } from "../utils/publications";
import { academicAppointment } from "@data/academic-appointment";
import { leadershipRoles } from "@data/leadership";
import { researchTopicPath } from "@data/research-topics";
import { publicationSearchEntry } from "../utils/publication-records";

import "../styles/home.css";

const books = (await getCollection("books")).sort((a, b) => yearRank(b.data.year) - yearRank(a.data.year));
// Short homepage treatments; publication pages and citations retain full titles.
const articleNotes: Record<string, { title?: string; finding: string }> = {
  "municipal-administration": { finding: "Elected municipal clerks report focusing more on residents’ needs than appointed clerks do." },
  "private-funding": { finding: "Americans are wary of private election funding; arguments for and against bans change opinion only modestly." },
  "rising-seas": { title: "Rising Seas, Rising Concerns", finding: "Sea-level vulnerability is associated with greater support for climate mitigation, especially among residents strongly attached to their communities." },
  "short-haul-moves": { title: "Short-Haul Moves and the Political Geography of Partisanship", finding: "Short moves within metropolitan areas contribute modestly to partisan geographic sorting." }
};
const recentArticles = (await getCollection("publications"))
  .filter((entry) => entry.data.type === "Article" && /^\d{4}$/.test(String(entry.data.year)))
  .sort((a, b) => yearRank(b.data.year) - yearRank(a.data.year) || a.data.title.localeCompare(b.data.title))
  .slice(0, 3)
  .map((entry) => ({ ...publicationSearchEntry(entry), venue: entry.data.venue, note: articleNotes[entry.id] }));
const bookNotes: Record<string, string> = {
  "no-blank-check": "Americans care how presidents use power, even when they support the policy. Acting without Congress can carry political costs.",
  "particularistic-president": "Presidents govern the whole country, but their electoral incentives favor some places over others. Federal spending reveals the political geography of presidential representation."
};
const researchAreas = [
  {
    title: "Presidential power",
    href: researchTopicPath("presidential-power")
  },
  {
    title: "Democratic accountability",
    href: researchTopicPath("democratic-accountability")
  },
  {
    title: "Political geography",
    href: researchTopicPath("political-geography")
  },
  {
    title: "Federal spending",
    href: researchTopicPath("federal-resource-allocation")
  }
] as const;

const photoLinks = [
  {
    title: "Research",
    href: "/research/",
    image: "/images/andrew-reeves-hoover-rai-conference.jpg",
    alt: "Andrew Reeves speaking at the Hoover Institution Research on American Institutions conference",
    caption: "",
    credit: ""
  },
  {
    title: "Teaching",
    href: "/teaching/",
    image: "/images/editorial/classroom.jpg",
    alt: "Andrew Reeves teaching The Business of Elections at WashU",
    caption: "The Business of Elections",
    credit: ""
  },
  {
    title: "Talks and events",
    href: "/talks/",
    image: "/images/editorial/adriana-kugler-conversation.jpg",
    alt: "Adriana Kugler in conversation with Andrew Reeves at a Weidenbaum Center forum",
    caption: "",
    credit: "Jerry Naunheim Jr./WashU"
  }
] as const;

const personStructuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://andrewreeves.org/#andrew-reeves",
  name: "Andrew Reeves",
  url: "https://andrewreeves.org/",
  image: "https://andrewreeves.org/images/editorial/andrew-reeves-portrait.jpg",
  jobTitle: [
    academicAppointment.title,
    "Professor of Law by courtesy",
    "Director, Weidenbaum Center on the Economy, Government, and Public Policy",
    "Director, Frick Initiatives",
    "Senior Advisor to the Chancellor",
    "Co-Chair, Ordered Liberty Project",
    "Visiting Fellow"
  ],
  worksFor: [
    {
      "@type": "CollegeOrUniversity",
      name: "Washington University in St. Louis",
      url: "https://washu.edu/"
    },
    {
      "@type": "Organization",
      name: "Hoover Institution",
      url: "https://www.hoover.org/"
    }
  ],
  affiliation: [
    {
      "@type": "Organization",
      name: "Weidenbaum Center on the Economy, Government, and Public Policy",
      url: "https://wc.washu.edu/"
    },
    {
      "@type": "Organization",
      name: "Frick Initiatives",
      url: "https://frick.washu.edu/"
    }
  ],
  sameAs: [
    "https://scholar.google.com/citations?hl=en&user=xPSRkX4AAAAJ",
    "https://polisci.wustl.edu/people/andrew-reeves/",
    "https://wc.washu.edu/"
  ],
  knowsAbout: [
    "American politics",
    "Presidential power",
    "Democratic accountability",
    "Political geography",
    "Federal resource allocation",
    "Public opinion"
  ]
};
---

<BaseLayout active="Home" structuredData={personStructuredData}>
  <Fragment slot="head">
    <link rel="preload" as="image" href={responsiveImages["/images/editorial/andrew-reeves-portrait.jpg"].src} imagesrcset={responsiveImages["/images/editorial/andrew-reeves-portrait.jpg"].srcset} imagesizes="(max-width: 360px) 72px, (max-width: 480px) 20vw, (max-width: 760px) 96px, (max-width: 1000px) 160px, 300px" />
  </Fragment>
  <div class="home-page">
    <section class="container-wide home-intro" aria-labelledby="home-name">
      <figure class="home-portrait">
        <ResponsiveImage src="/images/editorial/andrew-reeves-portrait.jpg" alt="Portrait of Andrew Reeves" sizes="(max-width: 360px) 72px, (max-width: 480px) 20vw, (max-width: 760px) 96px, (max-width: 1000px) 160px, 300px" loading="eager" fetchpriority="high" />
      </figure>
      <div class="home-intro-copy">
        <h1 id="home-name" class="sr-only">Andrew Reeves</h1>
        <p class="home-intro-lede">Andrew Reeves is a political scientist and {academicAppointment.biographyRole} at Washington University in St. Louis. <span class="home-intro-fellowship">He is also a visiting fellow at the <a href="https://www.hoover.org/">Hoover Institution</a>.</span></p>
        <p class="home-intro-research">He studies power, place and accountability in American politics—how the public responds when presidents act alone, and how electoral incentives shape where federal dollars go.</p>
        <div class="home-links" aria-label="Primary homepage links">
          <a href="/cv/">CV</a>
          <a href="/contact/">Contact</a>
        </div>
      </div>
    </section>

    <nav class="container-wide home-photo-nav" aria-label="Explore Andrew Reeves’s work">
      {photoLinks.map((item, index) => (
        <a class="home-photo-link" href={item.href} aria-label={item.title} aria-describedby={item.caption || item.credit ? `home-photo-caption-${index}` : undefined}>
          <span class="home-photo-image">
            <span class="home-photo-crop">
              <ResponsiveImage src={item.image} alt={item.alt} loading="lazy" sizes="(max-width: 329px) 112px, (max-width: 470px) 34vw, (max-width: 760px) 160px, (min-width: 1280px) 382px, calc((100vw - 136px) / 3)" />
              {(item.caption || item.credit) && <span class="home-photo-caption" id={`home-photo-caption-${index}`}>{item.credit && <span class="sr-only">Photo: </span>}{item.caption || item.credit}</span>}
            </span>
          </span>
          <span class="home-photo-copy">
            <span class="home-photo-title">{item.title}</span>
          </span>
        </a>
      ))}
    </nav>

    <section id="leadership" class="container-wide home-leadership" aria-labelledby="leadership-heading">
      <h2 id="leadership-heading">University leadership</h2>
      <div class="home-leadership-copy">
        <dl>
          {leadershipRoles.map((item) => (
            <div id={item.id}>
              <dt><span class="home-leadership-role">{item.role}</span><a href={item.url}>{item.name}</a></dt>
              <dd>
                {item.paragraphs.map((paragraph) => {
                  const parts = paragraph.emphasis ? paragraph.text.split(paragraph.emphasis) : [paragraph.text];
                  return (
                    <p class:list={[paragraph.supporting && "home-leadership-supporting"]}>
                      {parts.map((part, index) => <>{index > 0 && <strong>{paragraph.emphasis}</strong>}{part}</>)}
                    </p>
                  );
                })}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="container-wide home-books" aria-labelledby="major-works-heading">
      <h2 id="major-works-heading">Books</h2>
      <div class="home-books-pair">
        {books.map((book) => (
          <article class="home-book">
            <a class="home-book-cover" href={`/books/#${book.id}`} aria-label={`${book.data.title} book page`}>
              <img src={book.data.cover} alt={`Cover of ${book.data.title}`} width={book.id === "particularistic-president" ? 427 : 415} height="648" loading="lazy" />
            </a>
            <div class="home-book-copy">
              <div class="home-book-heading">
                <h3><a href={`/books/#${book.id}`}>{book.data.title}</a></h3>
                <p class="home-book-author">With {book.data.coauthors.join(" and ")}</p>
                <p class="home-book-publication">{book.data.publisher}, {book.data.year}</p>
              </div>
              <p>{bookNotes[book.id] ?? book.data.summary}</p>
              <a class="home-text-link" href={`/books/#${book.id}`}>About the book<span class="sr-only">: {book.data.title}</span></a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="container-wide home-recent" aria-labelledby="recent-articles-heading">
      <div class="home-section-heading">
        <h2 id="recent-articles-heading">Recent articles</h2>
        <a class="home-text-link" href="/research/">All publications</a>
      </div>
      <ul class="home-article-list">
        {recentArticles.map((article) => (
          <li>
            <h3><a href={article.url} aria-label={article.note?.title ? article.title : undefined}>{article.note?.title ?? article.title}</a></h3>
            <p class="home-recent-finding">{article.note?.finding ?? article.summary}</p>
            <p>{article.venue} · {article.year}</p>
          </li>
        ))}
      </ul>
      <nav class="home-research-topics" aria-labelledby="research-topics-heading">
        <h3 id="research-topics-heading">Browse by topic</h3>
        <ul>{researchAreas.map((item) => <li><a href={item.href}>{item.title}</a></li>)}</ul>
      </nav>
    </section>

  </div>
</BaseLayout>
