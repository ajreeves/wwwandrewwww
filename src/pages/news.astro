<BaseLayout title="News & Media" active="News" description="Selected commentary and media coverage of Andrew Reeves's work on presidential power, disaster politics, and democratic accountability.">
  <PageHeader
    eyebrow="Commentary & Coverage"
    title="News & Media"
    intro="Selected essays, commentary, and media coverage on presidential power, disaster politics, political geography, and democratic accountability."
  />

  <FeatureBand
    eyebrow="Featured Panel"
    title="Election Analyst Panel"
    text="Andrew Reeves moderates the Election Analyst Panel at Political Analytics 2025 at Harvard University, featuring Dave Wasserman, Jacob Rubashkin, and Geoffrey Skelley."
    image="/images/andrew-harvard-page.jpg"
    alt="Election Analyst Panel at Political Analytics 2025, moderated by Andrew Reeves at Harvard University"
  />

  <section class="container-wide page-section">
    <div class="page-section-heading">
      <div>
        <p class="kicker mb-4">Commentary</p>
        <h2>Essays and Op-Eds</h2>
        <p class="mt-4 max-w-3xl text-xl leading-[1.55] text-muted">Public writing on presidential power, disaster politics, and electoral accountability.</p>
      </div>
    </div>
    <div class="grid gap-x-10 gap-y-0 lg:grid-cols-2">
      {
        commentary.map((item) => (
          <article class="editorial-card">
            <p class="small-caps mb-3">{item.outlet}{item.date ? ` · ${item.date}` : ""}</p>
            <h3 class="list-title">
              <a class="text-ink no-underline hover:text-olive-dark" href={item.url}>{item.title}</a>
            </h3>
          </article>
        ))
      }
    </div>
  </section>

  <section class="container-wide page-section">
    <div class="page-section-heading">
      <div>
        <p class="kicker mb-4">Coverage</p>
        <h2>Research in the Media</h2>
      </div>
    </div>
    <div class="grid gap-x-10 gap-y-0 lg:grid-cols-2">
      {
        coverage.map((item) => (
          <article class="editorial-card">
            <p class="small-caps mb-3">{item.outlet}{item.date ? ` · ${item.date}` : ""}</p>
            <h3 class="list-title">
              <a class="text-ink no-underline hover:text-olive-dark" href={item.url}>{item.title}</a>
            </h3>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
